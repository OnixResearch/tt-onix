+def _multi_tile_grid(num_devices: int, rows: int):
+    """Grid for a width-sharded tensor that spans several 32-row tiles (P35)."""
+    tiles = max(1, rows // ttnn.TILE_SIZE)
+    if tiles == 1:
+        return num_to_core_range_set(num_devices)
+    return ttnn.CoreRangeSet(
+        {
+            ttnn.CoreRange(
+                ttnn.CoreCoord(0, 0),
+                ttnn.CoreCoord(num_devices - 1, tiles - 1),
+            )
+        }
+    )
+
+
+
+def _multi_tile_lm_head_output(rows: int):
+    """LM-head output config that works above one 32-row tile (P35).
+
+    The packaged constant uses a fixed 32-row width shard, which the device
+    rejects for a 64-row tensor. Interleaved L1 has no height constraint and the
+    LM head only streams 0.6 GB per step, so the layout cost is negligible; at
+    32 rows the packaged constant is returned unchanged.
+    """
+    if rows > ttnn.TILE_SIZE:
+        return ttnn.L1_MEMORY_CONFIG
+    return ttnn.L1_WIDTH_SHARDED_MEMORY_CONFIG
+
+
