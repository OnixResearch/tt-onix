+    def _width_sharded_decode_shape(self, width):
+        """nanbeige43 P35: shard shape for a width-sharded decode tensor.
+
+        A width-sharded shard is one 32-row tile; above one tile the shard must be
+        (32, 2 * width) so the tensor still fits one shard per core. P34 derives
+        the arithmetic; identical to the packaged shape at 32 rows.
+        """
+        rows = self.tile_padded_batch_rows
+        if rows > ttnn.TILE_SIZE:
+            return (ttnn.TILE_SIZE, width * (rows // ttnn.TILE_SIZE))
+        return (rows, width)
+
