# Ignore build outputs from performing a nix-build or `nix build` command
result
result-*

# Ignore automatically generated local build and environment output.
.direnv
target/
__pycache__/
*.pyc
.pi/

# Runtime inspector and watcher logs are private operational artifacts.
/generated/

# Keep local credentials and downloaded model trees out of new commits.
# Already-tracked files and Git history require separate publication review.
.env
.env.*
!.env.example
.ssh/
*.pem
*.p12
*.key
/models/

# Host-specific privileged migration tooling stays local to the owner machine.
/scripts/qwen38-profile-service
/scripts/qwen38-profile-99.conf
