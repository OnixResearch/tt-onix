     # Generator contract — decode
 
+    def _rope_decode_tables(self, rd, required):
+        """Cached float32 cos/sin tables [P, rd] for TP decode RoPE (P grows on demand).
+
+        Row p equals the per-step computation it replaces (outer(p, inv_freq) -> cat -> cos/sin
+        in float32), so the gathered rows are bitwise identical to the recomputed trig.
+        """
+        tables = getattr(self, "_rope_tp_tables", None)
+        if tables is not None and tables[0].shape[0] >= required:
+            return tables
+        size = max(required, int(self.args.max_seq_len))
+        inv_freq = 1.0 / (self.args.rope_theta ** (torch.arange(0, rd, 2).float() / rd))
+        freqs = torch.outer(torch.arange(size, dtype=torch.float32), inv_freq)
+        emb = torch.cat([freqs, freqs], dim=-1)
+        self._rope_tp_tables = (emb.cos(), emb.sin())
+        return self._rope_tp_tables
+
