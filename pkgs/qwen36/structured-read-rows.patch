+def masked_prefill_plan(actual_len, buckets):
+    """Masked prefill segments [(bucket, chunk_start, length)] over `buckets`, or None.
+
+    Full EAGER_PREFILL_CHUNK_TOKENS chunks, then the tail in the smallest bucket that holds it."""
+    if not buckets:
+        return None
+    plan = []
+    start = 0
+    while actual_len - start > EAGER_PREFILL_CHUNK_TOKENS:
+        if EAGER_PREFILL_CHUNK_TOKENS not in buckets:
+            return None
+        plan.append((EAGER_PREFILL_CHUNK_TOKENS, start, EAGER_PREFILL_CHUNK_TOKENS))
+        start += EAGER_PREFILL_CHUNK_TOKENS
+    fitting = [b for b in buckets if b >= actual_len - start]
+    if not fitting:
+        return None
+    plan.append((fitting[0], start, actual_len - start))
+    return plan
+
