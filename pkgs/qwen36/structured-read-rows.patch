+        return tuple(sorted(getattr(self, "_masked_read_batches", None) or ()))
+
+    def _alloc_masked_read_batch_inputs(self, bucket, read_page_table):
+        """Persistent replicated inputs of one batched read trace; user u reads through row u.
+
+        The page tables, position table, and zero conv context never change; each replay
+        stages only the tokens and the logit selector."""
+        rep = ttnn.ReplicateTensorToMesh(self.device)
+        width = self.READ_BATCH_WIDTH
+        assert read_page_table.shape[0] >= width, f"the read page table needs {width} rows"
+        dn = next(layer.attention for layer in self.layers if not layer.is_full_attention)
+        block_size = get_block_size(self._paged_kv_caches)
+        assert bucket % block_size == 0, f"bucket {bucket} must be a multiple of the KV block {block_size}"
+        # A 32-multiple page-table width keeps the SDPA's zero-pad branch (a host write) out of the trace.
+        full_blocks = max(32, ((read_page_table.shape[-1] + 31) // 32) * 32)
+
+        def dev(t, dtype, layout):
+            return ttnn.from_torch(t, dtype=dtype, layout=layout, device=self.device, mesh_mapper=rep)
+
+        full_pts, chunk_pts = [], []
+        for user in range(width):
+            row = read_page_table[user : user + 1].to(torch.int32)
+            assert row.shape[-1] >= bucket // block_size, "a read page-table row must cover the bucket"
+            full = torch.zeros(1, full_blocks, dtype=torch.int32)
+            full[:, : min(row.shape[-1], full_blocks)] = row[:, :full_blocks]
+            full_pts.append(dev(full, ttnn.int32, ttnn.ROW_MAJOR_LAYOUT))
+            chunk_pts.append(dev(row[:, : bucket // block_size].contiguous(), ttnn.int32, ttnn.ROW_MAJOR_LAYOUT))
+        cos_t, sin_t = self._rope_tp_cos_sin_torch(0, bucket)
+        return {
+            "bucket": bucket,
+            "width": width,
+            # Every user of a replay fills its row's KV, used or not.
+            "rows": read_page_table[:width].to(torch.int32).clone(),
+            "token": dev(torch.zeros(width, bucket, dtype=torch.int32), ttnn.uint32, ttnn.ROW_MAJOR_LAYOUT),
+            "full_pts": full_pts,
+            "chunk_pts": chunk_pts,
+            "csi": dev(torch.zeros(1, dtype=torch.int32), ttnn.int32, ttnn.ROW_MAJOR_LAYOUT),
+            "cos": dev(cos_t, ttnn.bfloat16, ttnn.TILE_LAYOUT),
+            "sin": dev(sin_t, ttnn.bfloat16, ttnn.TILE_LAYOUT),
+            "conv_left": dev(
+                torch.zeros(width, dn.K - 1, dn.qkv_dim_tp, dtype=torch.bfloat16), ttnn.bfloat16, ttnn.TILE_LAYOUT
+            ),
+            "logit_sel": dev(
+                torch.zeros(1, 1, self.MASKED_LOGIT_ROWS, width * bucket), ttnn.bfloat16, ttnn.TILE_LAYOUT
+            ),
+        }
