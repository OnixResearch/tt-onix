+    def _forward_masked_read_batch_body(self, bufs):
+        """The batched read trace: READ_BATCH_WIDTH sequences from position 0 in one forward.
+
+        Rows are user-major ([u * bucket, (u + 1) * bucket) is user u), as in
+        prefill_paged_grouped: norms, MLPs, and GDN layers run over every row at once, and each
+        full-attention layer runs per user through that user's page tables. The selected rows
+        take the final norm and the LM head. Returns replicated logits [1, 1, 32, vocab]."""
+        width, bucket = bufs["width"], bufs["bucket"]
+        x = self.embd(bufs["token"])
+        x = ttnn.reshape(x, (1, 1, width * bucket, x.shape[-1]))
+        x = ttnn.to_memory_config(x, ttnn.DRAM_MEMORY_CONFIG)
+        for layer in self.layers:
+            attn_norm_config, ff_norm_config = layer.norm_configs("prefill")
+            attn_in = layer.attention_norm(x, mode=Mode.PREFILL, norm_config=attn_norm_config)
+            full = attn_in.shape[-1]
+            if layer.is_full_attention:
+                users = ttnn.reshape(attn_in, (1, width, bucket, full))
+                outs = []
+                for user in range(width):
+                    user_in = ttnn.reshape(users[:, user : user + 1, :, :], (1, 1, bucket, full))
+                    out = layer.attention.forward_prefill_paged(
+                        user_in,
+                        bufs["cos"],
+                        bufs["sin"],
+                        bufs["full_pts"][user],
+                        chunk_page_table=bufs["chunk_pts"][user],
+                        chunk_start_idx=0,
+                        chunk_start_idx_tensor=bufs["csi"],
+                    )
+                    ttnn.deallocate(user_in)
+                    outs.append(ttnn.reshape(out, (1, 1, bucket, out.shape[-1])))
+                attn_out = ttnn.concat(outs, dim=2)
+                for out in outs:
+                    ttnn.deallocate(out)
+            else:
+                attn_out = layer.attention.forward_prefill_batched_read(
+                    ttnn.reshape(attn_in, (width, bucket, full)),
+                    bufs["conv_left"],
+                    chunk_size=self.args.gdn_chunk_size,
+                )
+                attn_out = ttnn.reshape(attn_out, (1, 1, width * bucket, attn_out.shape[-1]))
+            ttnn.deallocate(attn_in)
+            h = ttnn.add(x, attn_out)
+            ttnn.deallocate(x)
+            ttnn.deallocate(attn_out)
+            ff_in = layer.ffn_norm(h, mode=Mode.PREFILL, norm_config=ff_norm_config)
+            ff_out = layer.feed_forward.forward(ff_in)
+            ttnn.deallocate(ff_in)
+            x = ttnn.add(h, ff_out)
+            ttnn.deallocate(h)
+            ttnn.deallocate(ff_out)
+        rows = ttnn.matmul(bufs["logit_sel"], x)
+        ttnn.deallocate(x)
+        rows = ttnn.to_memory_config(rows, ttnn.DRAM_MEMORY_CONFIG)
+        rows = self.norm(rows, mode=Mode.PREFILL)
+        return ttnn.to_memory_config(self._lm_head(rows), ttnn.DRAM_MEMORY_CONFIG)
+
+    def prefill_masked_read_batch(self, token_ids_list, read_positions_list):
+        """Structured reads of up to READ_BATCH_WIDTH sequences in one batched replay.
+
+        token_ids_list[u]: torch [1, T_u] with T_u within the largest batched bucket.
+        read_positions_list[u]: ascending, distinct positions in [0, T_u); at most
+        MASKED_LOGIT_ROWS rows over all sequences.
+        Returns host float32 [len(read_positions_list[u]), vocab_size] per sequence. Nothing is
+        installed: the replay leaves no decode state, only KV in rows 0.. of the read page table."""
+        width = self.READ_BATCH_WIDTH
+        count = len(token_ids_list)
+        assert 1 <= count <= width and len(read_positions_list) == count, "one position list per sequence"
+        lengths = [int(tokens.shape[1]) for tokens in token_ids_list]
+        fitting = [b for b in self.masked_read_batch_buckets() if b >= max(lengths)]
+        assert fitting, f"no batched read trace holds {max(lengths)} tokens"
+        bufs = self._masked_read_batches[fitting[0]]
+        bucket = bufs["bucket"]
+        tokens = torch.zeros(width, bucket, dtype=torch.int32)
+        selector = torch.zeros(1, 1, self.MASKED_LOGIT_ROWS, width * bucket, dtype=torch.float32)
+        row = 0
+        for user, (token_ids, positions, length) in enumerate(zip(token_ids_list, read_positions_list, lengths)):
+            positions = [int(position) for position in positions]
+            assert positions and positions == sorted(set(positions)), "read positions must be ascending and distinct"
+            assert 0 <= positions[0] and positions[-1] < length, "read positions must lie inside the sequence"
+            tokens[user, :length] = token_ids[0, :length].to(torch.int32)
+            for position in positions:
+                assert row < self.MASKED_LOGIT_ROWS, "the reads exceed the logit tile"
+                selector[0, 0, row, user * bucket + position] = 1.0
+                row += 1
+        rep = ttnn.ReplicateTensorToMesh(self.device)
+        ttnn.copy_host_to_device_tensor(
+            ttnn.from_torch(tokens, dtype=ttnn.uint32, layout=ttnn.ROW_MAJOR_LAYOUT, device=None, mesh_mapper=rep),
+            bufs["token"],
+        )
+        ttnn.copy_host_to_device_tensor(
+            ttnn.from_torch(selector, dtype=ttnn.bfloat16, layout=ttnn.TILE_LAYOUT, device=None, mesh_mapper=rep),
+            bufs["logit_sel"],
+        )
+        self._invalidate_read_prefix(bufs["rows"])
+        ttnn.execute_trace(self.device, bufs["trace_id"], cq_id=0, blocking=False)
+        tile = ttnn.to_torch(ttnn.get_device_tensors(bufs["output"])[0]).float()
+        tile = tile.reshape(self.MASKED_LOGIT_ROWS, -1)[:, : self.args.vocab_size]
+        results = []
+        start = 0
+        for positions in read_positions_list:
+            results.append(tile[start : start + len(positions)].clone())
+            start += len(positions)
+        return results
