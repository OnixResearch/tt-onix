+    def _alloc_prefix_cache_states(self, count):
+        """Persistent copies of the B=1 scratch's carried GDN state (recurrent state and conv
+        carry), one per generation prefix-cache entry.
+
+        Allocated, like the read prefix, before the first trace capture: a buffer allocated after
+        a capture could sit in a trace's scratch. The copies in both directions compile here."""
+        self._ensure_gdn_prefill_scratch()
+        states = []
+        for _ in range(int(count)):
+            state = []
+            for _dn, rec, _conv, carry, _zero0 in self._gdn_prefill_scratch:
+                rec_saved, carry_saved = ttnn.clone(rec), ttnn.clone(carry)
+                ttnn.copy(rec_saved, rec)
+                ttnn.copy(carry_saved, carry)
+                ttnn.copy(rec, rec_saved)
+                ttnn.copy(carry, carry_saved)
+                state.append((rec_saved, carry_saved))
+            states.append(state)
+        self._prefix_cache_states = states
+
+    def prefix_cache_state_count(self):
+        """Saved carried-state buffers available to the generation prefix cache."""
+        return len(getattr(self, "_prefix_cache_states", None) or ())
+
+    def _copy_prefix_state(self, index, to_saved):
+        """Copy the scratch's carried GDN state into saved state `index`, or back."""
+        states = getattr(self, "_prefix_cache_states", None) or ()
+        assert 0 <= index < len(states), f"prefix state {index} is not allocated"
+        for (_dn, rec, _conv, carry, _zero0), (rec_saved, carry_saved) in zip(
+            self._gdn_prefill_scratch, states[index]
+        ):
+            if to_saved:
+                ttnn.copy(rec, rec_saved)
+                ttnn.copy(carry, carry_saved)
+            else:
+                ttnn.copy(rec_saved, rec)
+                ttnn.copy(carry_saved, carry)
