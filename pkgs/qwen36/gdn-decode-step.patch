+++ b/models/demos/blackhole/qwen36/tt/gdn/kernels/step_writer.cpp
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: Apache-2.0
+// GDN decode step writer: stores row 0 of the bf16 gated output tiles into batch row b of the
+// persistent [1, B, Nv * Dv] output, then the 16 fp32 state tiles back in place.
+
+#include <stdint.h>
+
+#include "api/dataflow/dataflow_api.h"
+
+namespace {
+
+constexpr uint32_t kFaceBytes = 16 * 16 * 2;  // bf16 face
+constexpr uint32_t kRowSegmentBytes = 16 * 2;
+
+FORCE_INLINE uint32_t row_offset(uint32_t row) { return (row >= 16 ? 2 * kFaceBytes : 0) + (row & 15) * kRowSegmentBytes; }
+
+}  // namespace
+
+void kernel_main() {
+    constexpr uint32_t key_tiles = get_compile_time_arg_val(0);
+    constexpr uint32_t val_tiles = get_compile_time_arg_val(1);
+    constexpr uint32_t num_v_heads = get_compile_time_arg_val(2);
+    constexpr uint32_t state_tiles = key_tiles * val_tiles;
+
+    constexpr auto out_args = TensorAccessorArgs<3>();
+    constexpr auto state_args = TensorAccessorArgs<out_args.next_compile_time_args_offset()>();
+
+    const uint32_t out_addr = get_arg_val<uint32_t>(0);
+    const uint32_t state_addr = get_arg_val<uint32_t>(1);
+    const uint32_t instance_start = get_arg_val<uint32_t>(2);
+    const uint32_t instance_count = get_arg_val<uint32_t>(3);
+
+    constexpr uint32_t cb_out = 16;
+    constexpr uint32_t cb_sn = 22;
+    const uint32_t out_tile_bytes = get_tile_size(cb_out);
+    const uint32_t state_tile_bytes = get_tile_size(cb_sn);
+    const auto out = TensorAccessor(out_args, out_addr, out_tile_bytes);
+    const auto state = TensorAccessor(state_args, state_addr, state_tile_bytes);
+
+    for (uint32_t instance = instance_start; instance < instance_start + instance_count; instance++) {
+        const uint32_t batch = instance / num_v_heads;
+        const uint32_t head = instance % num_v_heads;
+
+        // The output arrives after compute has finished reading the new state.
+        cb_wait_front(cb_out, val_tiles);
+        const uint32_t out_l1 = get_read_ptr(cb_out);
+        const uint32_t offset = row_offset(batch);
+        for (uint32_t tile = 0; tile < val_tiles; tile++) {
+            const uint64_t dst = out.get_noc_addr(head * val_tiles + tile);
+            const uint32_t src = out_l1 + tile * out_tile_bytes;
+            noc_async_write(src, dst + offset, kRowSegmentBytes);
+            noc_async_write(src + kFaceBytes, dst + offset + kFaceBytes, kRowSegmentBytes);
+        }
+
+        cb_wait_front(cb_sn, state_tiles);
+        const uint32_t state_l1 = get_read_ptr(cb_sn);
+        const uint32_t state_base = instance * state_tiles;
+        for (uint32_t tile = 0; tile < state_tiles; tile++) {
+            noc_async_write(state_l1 + tile * state_tile_bytes, state.get_noc_addr(state_base + tile), state_tile_bytes);
+        }
+        noc_async_write_barrier();
+        cb_pop_front(cb_out, val_tiles);
+        cb_pop_front(cb_sn, state_tiles);
+    }
+}
