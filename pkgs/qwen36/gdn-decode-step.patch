+// SPDX-License-Identifier: Apache-2.0
+// GDN decode conv prep compute. Conv channel tiles: silu(s1*t0 + s2*t1 + s3*t2 + x*t3) with the
+// taps broadcast along the batch rows. Gate tiles: silu(z). Remaining tiles: copy. All results are
+// accumulated and packed in fp32.
+
+#include <cstdint>
+
+#include "api/compute/common.h"
+#include "api/compute/bcast.h"
+#include "api/compute/compute_kernel_api.h"
+#include "api/compute/eltwise_binary_sfpu.h"
+#include "api/compute/tile_move_copy.h"
+
+void kernel_main() {
+    constexpr uint32_t conv_tiles = get_compile_time_arg_val(0);
+    constexpr uint32_t gate_end_tile = get_compile_time_arg_val(1);
+
+    const uint32_t tile_start = get_arg_val<uint32_t>(0);
+    const uint32_t tile_count = get_arg_val<uint32_t>(1);
+
+    constexpr uint32_t cb_x = 0;
+    constexpr uint32_t cb_s1 = 1;
+    constexpr uint32_t cb_s2 = 2;
+    constexpr uint32_t cb_s3 = 3;
+    constexpr uint32_t cb_t0 = 4;
+    constexpr uint32_t cb_t1 = 5;
+    constexpr uint32_t cb_t2 = 6;
+    constexpr uint32_t cb_t3 = 7;
+    constexpr uint32_t cb_out = 16;
+
+    compute_kernel_hw_startup(cb_s1, cb_t0, cb_out);
+
+    for (uint32_t tile = tile_start; tile < tile_start + tile_count; tile++) {
+        cb_wait_front(cb_x, 1);
+        cb_reserve_back(cb_out, 1);
+        if (tile < conv_tiles) {
+            cb_wait_front(cb_s1, 1);
+            cb_wait_front(cb_s2, 1);
+            cb_wait_front(cb_s3, 1);
+            cb_wait_front(cb_t0, 1);
+            cb_wait_front(cb_t1, 1);
+            cb_wait_front(cb_t2, 1);
+            cb_wait_front(cb_t3, 1);
+            tile_regs_acquire();
+            mul_bcast_rows_init(cb_s1, cb_t0);
+            mul_tiles_bcast_rows(cb_s1, cb_t0, 0, 0, 0);
+            mul_bcast_rows_init(cb_s2, cb_t1);
+            mul_tiles_bcast_rows(cb_s2, cb_t1, 0, 0, 1);
+            mul_bcast_rows_init(cb_s3, cb_t2);
+            mul_tiles_bcast_rows(cb_s3, cb_t2, 0, 0, 2);
+            mul_bcast_rows_init(cb_x, cb_t3);
+            mul_tiles_bcast_rows(cb_x, cb_t3, 0, 0, 3);
+            add_binary_tile_init();
+            add_binary_tile(0, 1, 0);
+            add_binary_tile(2, 3, 2);
+            add_binary_tile(0, 2, 0);
+            silu_tile_init();
+            silu_tile(0);
+            tile_regs_commit();
+            tile_regs_wait();
+            pack_tile(0, cb_out);
+            tile_regs_release();
+            cb_pop_front(cb_s1, 1);
+            cb_pop_front(cb_s2, 1);
+            cb_pop_front(cb_s3, 1);
+            cb_pop_front(cb_t0, 1);
+            cb_pop_front(cb_t1, 1);
+            cb_pop_front(cb_t2, 1);
+            cb_pop_front(cb_t3, 1);
+        } else {
+            tile_regs_acquire();
+            copy_tile_init(cb_x);
+            copy_tile(cb_x, 0, 0);
+            if (tile < gate_end_tile) {
+                silu_tile_init();
+                silu_tile(0);
+            }
+            tile_regs_commit();
+            tile_regs_wait();
+            pack_tile(0, cb_out);
+            tile_regs_release();
+        }
+        cb_push_back(cb_out, 1);
+        cb_pop_front(cb_x, 1);
+    }
+}
diff --git stepbase/q38src/models/demos/blackhole/qwen36/tt/gdn/kernels/conv_reader.cpp stepbase/q38src/models/demos/blackhole/qwen36/tt/gdn/kernels/conv_reader.cpp
