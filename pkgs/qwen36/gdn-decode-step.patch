--- /dev/null
+++ b/models/demos/blackhole/qwen36/tt/gdn/kernels/conv_reader.cpp
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: Apache-2.0
+// GDN decode conv prep reader: loads the projection tile, and for conv channels the three
+// previous inputs and the four taps. It also performs the conv-state shift for its exclusive
+// channel tiles: st0 <- st1, st1 <- st2, st2 <- st3, st3 <- x.
+
+#include <stdint.h>
+
+#include "api/dataflow/dataflow_api.h"
+
+void kernel_main() {
+    constexpr uint32_t conv_tiles = get_compile_time_arg_val(0);
+
+    constexpr auto x_args = TensorAccessorArgs<1>();
+    constexpr auto s0_args = TensorAccessorArgs<x_args.next_compile_time_args_offset()>();
+    constexpr auto s1_args = TensorAccessorArgs<s0_args.next_compile_time_args_offset()>();
+    constexpr auto s2_args = TensorAccessorArgs<s1_args.next_compile_time_args_offset()>();
+    constexpr auto s3_args = TensorAccessorArgs<s2_args.next_compile_time_args_offset()>();
+    constexpr auto t0_args = TensorAccessorArgs<s3_args.next_compile_time_args_offset()>();
+    constexpr auto t1_args = TensorAccessorArgs<t0_args.next_compile_time_args_offset()>();
+    constexpr auto t2_args = TensorAccessorArgs<t1_args.next_compile_time_args_offset()>();
+    constexpr auto t3_args = TensorAccessorArgs<t2_args.next_compile_time_args_offset()>();
+
+    uint32_t arg = 0;
+    const uint32_t x_addr = get_arg_val<uint32_t>(arg++);
+    const uint32_t s0_addr = get_arg_val<uint32_t>(arg++);
+    const uint32_t s1_addr = get_arg_val<uint32_t>(arg++);
+    const uint32_t s2_addr = get_arg_val<uint32_t>(arg++);
+    const uint32_t s3_addr = get_arg_val<uint32_t>(arg++);
+    const uint32_t t0_addr = get_arg_val<uint32_t>(arg++);
+    const uint32_t t1_addr = get_arg_val<uint32_t>(arg++);
+    const uint32_t t2_addr = get_arg_val<uint32_t>(arg++);
+    const uint32_t t3_addr = get_arg_val<uint32_t>(arg++);
+    const uint32_t tile_start = get_arg_val<uint32_t>(arg++);
+    const uint32_t tile_count = get_arg_val<uint32_t>(arg++);
+
+    constexpr uint32_t cb_x = 0;
+    constexpr uint32_t cb_s1 = 1;
+    constexpr uint32_t cb_s2 = 2;
+    constexpr uint32_t cb_s3 = 3;
+    constexpr uint32_t cb_t0 = 4;
+    constexpr uint32_t cb_t1 = 5;
+    constexpr uint32_t cb_t2 = 6;
+    constexpr uint32_t cb_t3 = 7;
+    const uint32_t tile_bytes = get_tile_size(cb_x);
+
+    const auto x = TensorAccessor(x_args, x_addr, tile_bytes);
+    const auto s0 = TensorAccessor(s0_args, s0_addr, tile_bytes);
+    const auto s1 = TensorAccessor(s1_args, s1_addr, tile_bytes);
+    const auto s2 = TensorAccessor(s2_args, s2_addr, tile_bytes);
+    const auto s3 = TensorAccessor(s3_args, s3_addr, tile_bytes);
+    const auto t0 = TensorAccessor(t0_args, t0_addr, tile_bytes);
+    const auto t1 = TensorAccessor(t1_args, t1_addr, tile_bytes);
+    const auto t2 = TensorAccessor(t2_args, t2_addr, tile_bytes);
+    const auto t3 = TensorAccessor(t3_args, t3_addr, tile_bytes);
+
+    for (uint32_t tile = tile_start; tile < tile_start + tile_count; tile++) {
+        // State-shift writes issued from the previous iteration read these CB pages.
+        noc_async_write_barrier();
+        cb_reserve_back(cb_x, 1);
+        const uint32_t x_l1 = get_write_ptr(cb_x);
+        noc_async_read(x.get_noc_addr(tile), x_l1, tile_bytes);
+        if (tile < conv_tiles) {
+            cb_reserve_back(cb_s1, 1);
+            cb_reserve_back(cb_s2, 1);
+            cb_reserve_back(cb_s3, 1);
+            cb_reserve_back(cb_t0, 1);
+            cb_reserve_back(cb_t1, 1);
+            cb_reserve_back(cb_t2, 1);
+            cb_reserve_back(cb_t3, 1);
+            const uint32_t s1_l1 = get_write_ptr(cb_s1);
+            const uint32_t s2_l1 = get_write_ptr(cb_s2);
+            const uint32_t s3_l1 = get_write_ptr(cb_s3);
+            noc_async_read(s1.get_noc_addr(tile), s1_l1, tile_bytes);
+            noc_async_read(s2.get_noc_addr(tile), s2_l1, tile_bytes);
+            noc_async_read(s3.get_noc_addr(tile), s3_l1, tile_bytes);
+            noc_async_read(t0.get_noc_addr(tile), get_write_ptr(cb_t0), tile_bytes);
+            noc_async_read(t1.get_noc_addr(tile), get_write_ptr(cb_t1), tile_bytes);
+            noc_async_read(t2.get_noc_addr(tile), get_write_ptr(cb_t2), tile_bytes);
+            noc_async_read(t3.get_noc_addr(tile), get_write_ptr(cb_t3), tile_bytes);
+            noc_async_read_barrier();
+            // Shift the conv state for this channel tile. Each tile is owned by one core.
+            noc_async_write(s1_l1, s0.get_noc_addr(tile), tile_bytes);
+            noc_async_write(s2_l1, s1.get_noc_addr(tile), tile_bytes);
+            noc_async_write(s3_l1, s2.get_noc_addr(tile), tile_bytes);
+            noc_async_write(x_l1, s3.get_noc_addr(tile), tile_bytes);
+            cb_push_back(cb_s1, 1);
+            cb_push_back(cb_s2, 1);
+            cb_push_back(cb_s3, 1);
+            cb_push_back(cb_t0, 1);
+            cb_push_back(cb_t1, 1);
+            cb_push_back(cb_t2, 1);
+            cb_push_back(cb_t3, 1);
+        } else {
+            noc_async_read_barrier();
+        }
+        cb_push_back(cb_x, 1);
+    }
+    noc_async_write_barrier();
+}
diff --git stepbase/q38src/models/demos/blackhole/qwen36/tt/gdn/kernels/conv_writer.cpp stepbase/q38src/models/demos/blackhole/qwen36/tt/gdn/kernels/conv_writer.cpp
new file mode 100644
--- /dev/null
+++ b/models/demos/blackhole/qwen36/tt/gdn/kernels/conv_writer.cpp
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: Apache-2.0
+// GDN decode conv prep writer: stores each fp32 prep tile.
+
+#include <stdint.h>
+
+#include "api/dataflow/dataflow_api.h"
+
+void kernel_main() {
+    constexpr auto out_args = TensorAccessorArgs<0>();
+    const uint32_t out_addr = get_arg_val<uint32_t>(0);
+    const uint32_t tile_start = get_arg_val<uint32_t>(1);
+    const uint32_t tile_count = get_arg_val<uint32_t>(2);
+
+    constexpr uint32_t cb_out = 16;
+    const uint32_t tile_bytes = get_tile_size(cb_out);
+    const auto out = TensorAccessor(out_args, out_addr, tile_bytes);
+
+    for (uint32_t tile = tile_start; tile < tile_start + tile_count; tile++) {
+        cb_wait_front(cb_out, 1);
+        noc_async_write(get_read_ptr(cb_out), out.get_noc_addr(tile), tile_bytes);
+        noc_async_write_barrier();
+        cb_pop_front(cb_out, 1);
+    }
+}
diff --git stepbase/q38src/models/demos/blackhole/qwen36/tt/gdn/kernels/step_compute.cpp stepbase/q38src/models/demos/blackhole/qwen36/tt/gdn/kernels/step_compute.cpp
new file mode 100644
--- /dev/null
+++ b/models/demos/blackhole/qwen36/tt/gdn/kernels/step_compute.cpp
@@ -0,0 +1,369 @@
+// SPDX-License-Identifier: Apache-2.0
+// GDN decode step compute, one (batch, value-head) instance at a time:
+//   beta = sigmoid(b); decay = exp(-exp(A) * softplus(a + dt_bias))
+//   k = k / ||k||; q = q / ||q|| * scale
+//   S' = decay * S; delta = (v - k S') * beta; S = S' + k^T delta; o = q S
+//   out = rmsnorm(o) * norm_w * silu(z)        (silu(z) arrives precomputed)
+// Vectors live in row 0 of zero-padded fp32 tiles; the reader guarantees zero padding.
+//
+// Precision: the recurrent state never passes through the 19-bit source registers. It is unpacked
+// straight to fp32 DEST, decayed with an fp32 SFPU multiply, and the outer-product update is
+// accumulated on top of it in fp32 DEST. Only matmul operands (k, q, delta, and the read-side copies
+// of the state) are rounded to tf32. CBs marked "exact" below are unpacked to DEST in fp32.
+
+#include <cstdint>
+
+#include "api/compute/common.h"
+#include "api/compute/bcast.h"
+#include "api/compute/compute_kernel_api.h"
+#include "api/compute/eltwise_binary_sfpu.h"
+#include "api/compute/eltwise_unary/binop_with_scalar.h"
+#include "api/compute/eltwise_unary/exp.h"
+#include "api/compute/eltwise_unary/rsqrt.h"
+#include "api/compute/eltwise_unary/softplus.h"
+#include "api/compute/matmul.h"
+#include "api/compute/pack.h"
+#include "api/compute/reconfig_data_format.h"
+#include "api/compute/tile_move_copy.h"
+#include "api/compute/transpose.h"
+
+namespace {
+
+constexpr uint32_t kOne = 0x3F800000u;      // 1.0f
+constexpr uint32_t kTwenty = 0x41A00000u;   // 20.0f
+constexpr uint32_t kL2Eps = 0x358637BDu;    // 1e-6f
+constexpr uint32_t kNormEps = 0x358637BDu;  // 1e-6f
+
+// Inputs from the reader.
+constexpr uint32_t cb_q = 0;
+constexpr uint32_t cb_k = 1;
+constexpr uint32_t cb_v = 2;      // exact
+constexpr uint32_t cb_z = 3;      // exact
+constexpr uint32_t cb_a = 4;
+constexpr uint32_t cb_b = 5;
+constexpr uint32_t cb_dt = 6;
+constexpr uint32_t cb_na = 7;
+constexpr uint32_t cb_state = 8;  // exact
+constexpr uint32_t cb_nw = 9;     // exact
+// Intermediates.
+constexpr uint32_t cb_beta = 11;   // exact
+constexpr uint32_t cb_decay = 12;  // exact
+constexpr uint32_t cb_invk = 13;
+constexpr uint32_t cb_invq = 14;
+constexpr uint32_t cb_kn = 15;
+constexpr uint32_t cb_out = 16;  // bf16
+constexpr uint32_t cb_qn = 17;
+constexpr uint32_t cb_kcol = 18;
+constexpr uint32_t cb_sd = 19;    // S' for the matmul read
+constexpr uint32_t cb_vr = 20;    // exact
+constexpr uint32_t cb_db = 21;
+constexpr uint32_t cb_sn = 22;
+constexpr uint32_t cb_o = 23;
+constexpr uint32_t cb_invo = 24;
+constexpr uint32_t cb_sdx = 26;   // exact S' for the state update
+constexpr uint32_t cb_ox = 27;    // exact o for the gated norm
+
+// dst[0] = rsqrt(sum_j x[0, j]^2 * pre_scale + eps) * post_scale, packed to `out_cb`.
+template <uint32_t tiles>
+ALWI void inverse_norm(uint32_t in_cb, uint32_t out_cb, uint32_t pre_scale, uint32_t eps, uint32_t post_scale) {
+    cb_reserve_back(out_cb, 1);
+    reconfig_data_format(in_cb, in_cb);
+    tile_regs_acquire();
+    matmul_init(in_cb, in_cb, 1);
+    for (uint32_t tile = 0; tile < tiles; tile++) {
+        matmul_tiles(in_cb, in_cb, tile, tile, 0);
+    }
+    binop_with_scalar_tile_init();
+    if (pre_scale != kOne) {
+        mul_unary_tile(0, pre_scale);
+    }
+    add_unary_tile(0, eps);
+    rsqrt_tile_init();
+    rsqrt_tile(0);
+    if (post_scale != kOne) {
+        binop_with_scalar_tile_init();
+        mul_unary_tile(0, post_scale);
+    }
+    tile_regs_commit();
+    tile_regs_wait();
+    pack_tile(0, out_cb);
+    tile_regs_release();
+    cb_push_back(out_cb, 1);
+}
+
+// out[i] = in[i] * scalar(0, 0) for `tiles` tiles (tf32 operands).
+template <uint32_t tiles>
+ALWI void scale_rows(uint32_t in_cb, uint32_t scalar_cb, uint32_t out_cb) {
+    cb_reserve_back(out_cb, tiles);
+    reconfig_data_format(in_cb, scalar_cb);
+    tile_regs_acquire();
+    mul_bcast_scalar_init(in_cb, scalar_cb);
+    for (uint32_t tile = 0; tile < tiles; tile++) {
+        mul_tiles_bcast_scalar(in_cb, scalar_cb, tile, 0, tile);
+    }
+    tile_regs_commit();
+    tile_regs_wait();
+    for (uint32_t tile = 0; tile < tiles; tile++) {
+        pack_tile(tile, out_cb, tile);
+    }
+    tile_regs_release();
+    cb_push_back(out_cb, tiles);
+}
+
+// dst[idst] = broadcast of element (0, 0) of a tf32 (default-mode) CB. Unpack-to-DEST broadcast is
+// unreliable once SFPU state has been programmed, so scalars always take the source-register path;
+// every scalar broadcast here is bf16-exact or only scales a bf16 output.
+ALWI void broadcast_scalar(uint32_t cb, uint32_t idst) {
+    reconfig_data_format(cb, cb);
+    unary_bcast_init<BroadcastType::SCALAR>(cb);
+    unary_bcast<BroadcastType::SCALAR>(cb, 0, idst);
+    unary_bcast_uninit<BroadcastType::SCALAR>(cb);
+}
+
+// dst[idst] = exact copy of tile `tile` of an exact CB.
+ALWI void copy_exact(uint32_t cb, uint32_t tile, uint32_t idst) {
+    reconfig_data_format_srca(cb);
+    copy_tile_init(cb);
+    copy_tile(cb, tile, idst);
+}
+
+}  // namespace
+
+void kernel_main() {
+    constexpr uint32_t key_tiles = get_compile_time_arg_val(0);
+    constexpr uint32_t val_tiles = get_compile_time_arg_val(1);
+    constexpr uint32_t q_scale = get_compile_time_arg_val(2);    // fp32 bits of Dk^-0.5
+    constexpr uint32_t inv_width = get_compile_time_arg_val(3);  // fp32 bits of 1 / Dv
+    constexpr uint32_t state_tiles = key_tiles * val_tiles;
+    static_assert(key_tiles == 4 && val_tiles == 4, "dst batching assumes 4x4 state tiles");
+
+    const uint32_t instance_count = get_arg_val<uint32_t>(0);
+
+    compute_kernel_hw_startup<SrcOrder::Reverse>(cb_k, cb_sd, cb_kn);
+
+    cb_wait_front(cb_nw, val_tiles);
+
+    for (uint32_t instance = 0; instance < instance_count; instance++) {
+        // beta = sigmoid(b) and decay = exp(-exp(A) * softplus(a + dt_bias)), as full fp32 tiles.
+        cb_wait_front(cb_a, 1);
+        cb_wait_front(cb_b, 1);
+        cb_wait_front(cb_dt, 1);
+        cb_wait_front(cb_na, 1);
+        cb_reserve_back(cb_beta, 1);
+        cb_reserve_back(cb_decay, 1);
+        tile_regs_acquire();
+        broadcast_scalar(cb_b, 0);
+        broadcast_scalar(cb_a, 1);
+        broadcast_scalar(cb_dt, 2);
+        broadcast_scalar(cb_na, 3);
+        sigmoid_tile_init();
+        sigmoid_tile(0);
+        add_binary_tile_init();
+        add_binary_tile(1, 2, 1);
+        softplus_tile_init();
+        softplus_tile(1, kOne, kOne, kTwenty);
+        mul_binary_tile_init();
+        mul_binary_tile(1, 3, 1);
+        exp_tile_init<false>();
+        exp_tile<false>(1);
+        tile_regs_commit();
+        tile_regs_wait();
+        pack_tile(0, cb_beta);
+        pack_tile(1, cb_decay);
+        tile_regs_release();
+        cb_push_back(cb_beta, 1);
+        cb_push_back(cb_decay, 1);
+        cb_pop_front(cb_a, 1);
+        cb_pop_front(cb_b, 1);
+        cb_pop_front(cb_dt, 1);
+        cb_pop_front(cb_na, 1);
+
+        // k = k / ||k||, k_col = transpose(k).
+        cb_wait_front(cb_k, key_tiles);
+        inverse_norm<key_tiles>(cb_k, cb_invk, kOne, kL2Eps, kOne);
+        cb_wait_front(cb_invk, 1);
+        scale_rows<key_tiles>(cb_k, cb_invk, cb_kn);
+        cb_pop_front(cb_invk, 1);
+        cb_pop_front(cb_k, key_tiles);
+        cb_wait_front(cb_kn, key_tiles);
+        cb_reserve_back(cb_kcol, key_tiles);
+        reconfig_data_format_srca(cb_kn);
+        tile_regs_acquire();
+        transpose_init(cb_kn);
+        for (uint32_t tile = 0; tile < key_tiles; tile++) {
+            transpose_tile(cb_kn, tile, tile);
+        }
+        tile_regs_commit();
+        tile_regs_wait();
+        for (uint32_t tile = 0; tile < key_tiles; tile++) {
+            pack_tile(tile, cb_kcol, tile);
+        }
+        tile_regs_release();
+        cb_push_back(cb_kcol, key_tiles);
+
+        // q = q / ||q|| * scale.
+        cb_wait_front(cb_q, key_tiles);
+        inverse_norm<key_tiles>(cb_q, cb_invq, kOne, kL2Eps, q_scale);
+        cb_wait_front(cb_invq, 1);
+        scale_rows<key_tiles>(cb_q, cb_invq, cb_qn);
+        cb_pop_front(cb_invq, 1);
+        cb_pop_front(cb_q, key_tiles);
+
+        // S' = decay * S in fp32, kept twice: tf32-readable for the matmul, exact for the update.
+        cb_wait_front(cb_state, state_tiles);
+        cb_wait_front(cb_decay, 1);
+        cb_reserve_back(cb_sd, state_tiles);
+        cb_reserve_back(cb_sdx, state_tiles);
+        for (uint32_t first = 0; first < state_tiles; first += 3) {
+            const uint32_t count = state_tiles - first < 3 ? state_tiles - first : 3;
+            tile_regs_acquire();
+            copy_exact(cb_decay, 0, 3);
+            copy_exact(cb_state, first, 0);
+            for (uint32_t tile = 1; tile < count; tile++) {
+                copy_tile(cb_state, first + tile, tile);
+            }
+            mul_binary_tile_init();
+            for (uint32_t tile = 0; tile < count; tile++) {
+                mul_binary_tile(tile, 3, tile);
+            }
+            tile_regs_commit();
+            tile_regs_wait();
+            for (uint32_t tile = 0; tile < count; tile++) {
+                pack_tile(tile, cb_sd, first + tile);
+                pack_tile(tile, cb_sdx, first + tile);
+            }
+            tile_regs_release();
+        }
+        cb_push_back(cb_sd, state_tiles);
+        cb_push_back(cb_sdx, state_tiles);
+        cb_pop_front(cb_state, state_tiles);
+        cb_pop_front(cb_decay, 1);
+
+        // v_read = k S'.
+        cb_wait_front(cb_sd, state_tiles);
+        cb_reserve_back(cb_vr, val_tiles);
+        reconfig_data_format(cb_sd, cb_kn);
+        tile_regs_acquire();
+        matmul_init(cb_kn, cb_sd);
+        for (uint32_t val_tile = 0; val_tile < val_tiles; val_tile++) {
+            for (uint32_t key_tile = 0; key_tile < key_tiles; key_tile++) {
+                matmul_tiles(cb_kn, cb_sd, key_tile, key_tile * val_tiles + val_tile, val_tile);
+            }
+        }
+        tile_regs_commit();
+        tile_regs_wait();
+        for (uint32_t tile = 0; tile < val_tiles; tile++) {
+            pack_tile(tile, cb_vr, tile);
+        }
+        tile_regs_release();
+        cb_push_back(cb_vr, val_tiles);
+        cb_pop_front(cb_kn, key_tiles);
+        cb_pop_front(cb_sd, state_tiles);
+
+        // delta = (v - v_read) * beta in fp32.
+        cb_wait_front(cb_v, val_tiles);
+        cb_wait_front(cb_vr, val_tiles);
+        cb_wait_front(cb_beta, 1);
+        cb_reserve_back(cb_db, val_tiles);
+        for (uint32_t tile = 0; tile < val_tiles; tile++) {
+            tile_regs_acquire();
+            copy_exact(cb_v, tile, 0);
+            copy_exact(cb_vr, tile, 1);
+            copy_exact(cb_beta, 0, 2);
+            sub_binary_tile_init();
+            sub_binary_tile(0, 1, 0);
+            mul_binary_tile_init();
+            mul_binary_tile(0, 2, 0);
+            tile_regs_commit();
+            tile_regs_wait();
+            pack_tile(0, cb_db, tile);
+            tile_regs_release();
+        }
+        cb_push_back(cb_db, val_tiles);
+        cb_pop_front(cb_v, val_tiles);
+        cb_pop_front(cb_vr, val_tiles);
+        cb_pop_front(cb_beta, 1);
+
+        // S = S' + k_col delta: exact S' in DEST, the rank-1 update accumulated on top.
+        cb_wait_front(cb_kcol, key_tiles);
+        cb_wait_front(cb_db, val_tiles);
+        cb_wait_front(cb_sdx, state_tiles);
+        cb_reserve_back(cb_sn, state_tiles);
+        for (uint32_t key_tile = 0; key_tile < key_tiles; key_tile++) {
+            tile_regs_acquire();
+            copy_exact(cb_sdx, key_tile * val_tiles, 0);
+            for (uint32_t val_tile = 1; val_tile < val_tiles; val_tile++) {
+                copy_tile(cb_sdx, key_tile * val_tiles + val_tile, val_tile);
+            }
+            reconfig_data_format(cb_db, cb_kcol);
+            matmul_init(cb_kcol, cb_db);
+            for (uint32_t val_tile = 0; val_tile < val_tiles; val_tile++) {
+                matmul_tiles(cb_kcol, cb_db, key_tile, val_tile, val_tile);
+            }
+            tile_regs_commit();
+            tile_regs_wait();
+            for (uint32_t val_tile = 0; val_tile < val_tiles; val_tile++) {
+                pack_tile(val_tile, cb_sn, key_tile * val_tiles + val_tile);
+            }
+            tile_regs_release();
+        }
+        cb_push_back(cb_sn, state_tiles);
+        cb_pop_front(cb_sdx, state_tiles);
+        cb_pop_front(cb_kcol, key_tiles);
+        cb_pop_front(cb_db, val_tiles);
+
+        // o = q S. The writer pops cb_sn after it observes the output.
+        cb_wait_front(cb_qn, key_tiles);
+        cb_wait_front(cb_sn, state_tiles);
+        cb_reserve_back(cb_o, val_tiles);
+        cb_reserve_back(cb_ox, val_tiles);
+        reconfig_data_format(cb_sn, cb_qn);
+        tile_regs_acquire();
+        matmul_init(cb_qn, cb_sn);
+        for (uint32_t val_tile = 0; val_tile < val_tiles; val_tile++) {
+            for (uint32_t key_tile = 0; key_tile < key_tiles; key_tile++) {
+                matmul_tiles(cb_qn, cb_sn, key_tile, key_tile * val_tiles + val_tile, val_tile);
+            }
+        }
+        tile_regs_commit();
+        tile_regs_wait();
+        for (uint32_t tile = 0; tile < val_tiles; tile++) {
+            pack_tile(tile, cb_o, tile);
+            pack_tile(tile, cb_ox, tile);
+        }
+        tile_regs_release();
+        cb_push_back(cb_o, val_tiles);
+        cb_push_back(cb_ox, val_tiles);
+        cb_pop_front(cb_qn, key_tiles);
+
+        // out = o * rsqrt(mean(o^2) + eps) * norm_w * silu(z), packed to bf16.
+        cb_wait_front(cb_o, val_tiles);
+        inverse_norm<val_tiles>(cb_o, cb_invo, inv_width, kNormEps, kOne);
+        cb_pop_front(cb_o, val_tiles);
+        cb_wait_front(cb_invo, 1);
+        cb_wait_front(cb_ox, val_tiles);
+        cb_wait_front(cb_z, val_tiles);
+        cb_reserve_back(cb_out, val_tiles);
+        for (uint32_t tile = 0; tile < val_tiles; tile++) {
+            tile_regs_acquire();
+            copy_exact(cb_ox, tile, 0);
+            copy_exact(cb_nw, tile, 1);
+            copy_exact(cb_z, tile, 2);
+            broadcast_scalar(cb_invo, 3);
+            mul_binary_tile_init();
+            mul_binary_tile(0, 3, 0);
+            mul_binary_tile(0, 1, 0);
+            mul_binary_tile(0, 2, 0);
+            tile_regs_commit();
+            tile_regs_wait();
+            pack_reconfig_data_format(cb_out);
+            pack_tile(0, cb_out, tile);
+            pack_reconfig_data_format(cb_ox);
+            tile_regs_release();
+        }
+        cb_push_back(cb_out, val_tiles);
+        cb_pop_front(cb_invo, 1);
+        cb_pop_front(cb_ox, val_tiles);
+        cb_pop_front(cb_z, val_tiles);
+    }
+}
diff --git stepbase/q38src/models/demos/blackhole/qwen36/tt/gdn/kernels/step_reader.cpp stepbase/q38src/models/demos/blackhole/qwen36/tt/gdn/kernels/step_reader.cpp
