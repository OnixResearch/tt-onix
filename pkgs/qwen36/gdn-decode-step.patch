--- /dev/null
+++ b/models/demos/blackhole/qwen36/tt/gdn/kernels/step_reader.cpp
@@ -0,0 +1,175 @@
+// SPDX-License-Identifier: Apache-2.0
+// GDN decode step reader. For instance (b, h) it copies batch row b of the fp32 prep tiles into row 0
+// of zeroed CB tiles (q and k from key head h / rf, v and gate from value head h), places the
+// a/b/dt_bias/-exp(A) scalars at element (0, 0), and streams the 16 fp32 recurrent-state tiles.
+
+#include <stdint.h>
+
+#include "api/dataflow/dataflow_api.h"
+
+namespace {
+
+constexpr uint32_t kFaceBytes = 16 * 16 * 4;  // fp32 face
+constexpr uint32_t kRowSegmentBytes = 16 * 4;
+
+FORCE_INLINE uint32_t row_offset(uint32_t row) { return (row >= 16 ? 2 * kFaceBytes : 0) + (row & 15) * kRowSegmentBytes; }
+
+FORCE_INLINE uint32_t element_offset(uint32_t row, uint32_t col) {
+    const uint32_t face = (row >= 16 ? 2 : 0) + (col >= 16 ? 1 : 0);
+    return face * kFaceBytes + ((row & 15) * 16 + (col & 15)) * 4;
+}
+
+template <typename Accessor>
+FORCE_INLINE void read_row(const Accessor& src, uint32_t tile, uint32_t row, uint32_t dst_l1) {
+    const uint64_t base = src.get_noc_addr(tile);
+    const uint32_t offset = row_offset(row);
+    noc_async_read(base + offset, dst_l1, kRowSegmentBytes);
+    noc_async_read(base + offset + kFaceBytes, dst_l1 + kFaceBytes, kRowSegmentBytes);
+}
+
+template <typename Accessor>
+FORCE_INLINE void stage_element(const Accessor& src, uint32_t tile, uint32_t row, uint32_t col, uint32_t scratch_l1) {
+    const uint32_t offset = element_offset(row, col);
+    const uint32_t aligned = offset & ~63u;
+    noc_async_read(src.get_noc_addr(tile) + aligned, scratch_l1, 64);
+}
+
+FORCE_INLINE void store_element(uint32_t scratch_l1, uint32_t row, uint32_t col, uint32_t dst_l1) {
+    const uint32_t offset = element_offset(row, col);
+    const uint32_t aligned = offset & ~63u;
+    *reinterpret_cast<volatile uint32_t*>(dst_l1) =
+        *reinterpret_cast<volatile uint32_t*>(scratch_l1 + (offset - aligned));
+}
+
+FORCE_INLINE void zero_pages(uint32_t cb, uint32_t pages, uint32_t page_bytes) {
+    cb_reserve_back(cb, pages);
+    const uint64_t zeros = get_noc_addr(MEM_ZEROS_BASE);
+    uint32_t dst = get_write_ptr(cb);
+    for (uint32_t byte = 0; byte < pages * page_bytes; byte += MEM_ZEROS_SIZE) {
+        noc_async_read(zeros, dst + byte, MEM_ZEROS_SIZE);
+    }
+}
+
+}  // namespace
+
+void kernel_main() {
+    constexpr uint32_t key_tiles = get_compile_time_arg_val(0);
+    constexpr uint32_t val_tiles = get_compile_time_arg_val(1);
+    constexpr uint32_t head_ratio = get_compile_time_arg_val(2);
+    constexpr uint32_t num_v_heads = get_compile_time_arg_val(3);
+    constexpr uint32_t q_tile_base = get_compile_time_arg_val(4);
+    constexpr uint32_t k_tile_base = get_compile_time_arg_val(5);
+    constexpr uint32_t v_tile_base = get_compile_time_arg_val(6);
+    constexpr uint32_t z_tile_base = get_compile_time_arg_val(7);
+    constexpr uint32_t a_column = get_compile_time_arg_val(8);
+    constexpr uint32_t b_column = get_compile_time_arg_val(9);
+    constexpr uint32_t state_tiles = key_tiles * val_tiles;
+
+    constexpr auto prep_args = TensorAccessorArgs<10>();
+    constexpr auto state_args = TensorAccessorArgs<prep_args.next_compile_time_args_offset()>();
+    constexpr auto dt_args = TensorAccessorArgs<state_args.next_compile_time_args_offset()>();
+    constexpr auto na_args = TensorAccessorArgs<dt_args.next_compile_time_args_offset()>();
+    constexpr auto nw_args = TensorAccessorArgs<na_args.next_compile_time_args_offset()>();
+
+    uint32_t arg = 0;
+    const uint32_t prep_addr = get_arg_val<uint32_t>(arg++);
+    const uint32_t state_addr = get_arg_val<uint32_t>(arg++);
+    const uint32_t dt_addr = get_arg_val<uint32_t>(arg++);
+    const uint32_t na_addr = get_arg_val<uint32_t>(arg++);
+    const uint32_t nw_addr = get_arg_val<uint32_t>(arg++);
+    const uint32_t instance_start = get_arg_val<uint32_t>(arg++);
+    const uint32_t instance_count = get_arg_val<uint32_t>(arg++);
+
+    constexpr uint32_t cb_q = 0;
+    constexpr uint32_t cb_k = 1;
+    constexpr uint32_t cb_v = 2;
+    constexpr uint32_t cb_z = 3;
+    constexpr uint32_t cb_a = 4;
+    constexpr uint32_t cb_b = 5;
+    constexpr uint32_t cb_dt = 6;
+    constexpr uint32_t cb_na = 7;
+    constexpr uint32_t cb_state = 8;
+    constexpr uint32_t cb_nw = 9;
+    constexpr uint32_t cb_scratch = 10;
+    const uint32_t tile_bytes = get_tile_size(cb_state);
+
+    const auto prep = TensorAccessor(prep_args, prep_addr, tile_bytes);
+    const auto state = TensorAccessor(state_args, state_addr, tile_bytes);
+    const auto dt = TensorAccessor(dt_args, dt_addr, tile_bytes);
+    const auto na = TensorAccessor(na_args, na_addr, tile_bytes);
+    const auto nw = TensorAccessor(nw_args, nw_addr, tile_bytes);
+
+    // Zero every page that receives partial rows, once. The reader only ever rewrites row 0
+    // (or element (0, 0)), so the padding stays zero for every instance on this core.
+    zero_pages(cb_q, key_tiles, tile_bytes);
+    zero_pages(cb_k, key_tiles, tile_bytes);
+    zero_pages(cb_v, val_tiles, tile_bytes);
+    zero_pages(cb_z, val_tiles, tile_bytes);
+    zero_pages(cb_a, 1, tile_bytes);
+    zero_pages(cb_b, 1, tile_bytes);
+    zero_pages(cb_dt, 1, tile_bytes);
+    zero_pages(cb_na, 1, tile_bytes);
+    noc_async_read_barrier();
+
+    cb_reserve_back(cb_scratch, 1);
+    const uint32_t scratch = get_write_ptr(cb_scratch);
+
+    // Persistent gated-norm weight (host broadcasts it across all 32 rows).
+    cb_reserve_back(cb_nw, val_tiles);
+    for (uint32_t tile = 0; tile < val_tiles; tile++) {
+        noc_async_read(nw.get_noc_addr(tile), get_write_ptr(cb_nw) + tile * tile_bytes, tile_bytes);
+    }
+    noc_async_read_barrier();
+    cb_push_back(cb_nw, val_tiles);
+
+    for (uint32_t instance = instance_start; instance < instance_start + instance_count; instance++) {
+        const uint32_t batch = instance / num_v_heads;
+        const uint32_t head = instance % num_v_heads;
+        const uint32_t key_head = head / head_ratio;
+
+        cb_reserve_back(cb_q, key_tiles);
+        cb_reserve_back(cb_k, key_tiles);
+        cb_reserve_back(cb_v, val_tiles);
+        cb_reserve_back(cb_z, val_tiles);
+        cb_reserve_back(cb_a, 1);
+        cb_reserve_back(cb_b, 1);
+        cb_reserve_back(cb_dt, 1);
+        cb_reserve_back(cb_na, 1);
+        cb_reserve_back(cb_state, state_tiles);
+
+        for (uint32_t tile = 0; tile < key_tiles; tile++) {
+            read_row(prep, q_tile_base + key_head * key_tiles + tile, batch, get_write_ptr(cb_q) + tile * tile_bytes);
+            read_row(prep, k_tile_base + key_head * key_tiles + tile, batch, get_write_ptr(cb_k) + tile * tile_bytes);
+        }
+        for (uint32_t tile = 0; tile < val_tiles; tile++) {
+            read_row(prep, v_tile_base + head * val_tiles + tile, batch, get_write_ptr(cb_v) + tile * tile_bytes);
+            read_row(prep, z_tile_base + head * val_tiles + tile, batch, get_write_ptr(cb_z) + tile * tile_bytes);
+        }
+        const uint32_t state_base = instance * state_tiles;
+        const uint32_t state_l1 = get_write_ptr(cb_state);
+        for (uint32_t tile = 0; tile < state_tiles; tile++) {
+            noc_async_read(state.get_noc_addr(state_base + tile), state_l1 + tile * tile_bytes, tile_bytes);
+        }
+        // Stage the four scalar reads behind the same barrier as the row and state reads; each
+        // scalar previously paid its own NOC round trip.
+        stage_element(prep, (a_column + head) / 32, batch, (a_column + head) % 32, scratch);
+        stage_element(prep, (b_column + head) / 32, batch, (b_column + head) % 32, scratch + 64);
+        stage_element(dt, head / 32, 0, head % 32, scratch + 128);
+        stage_element(na, head / 32, 0, head % 32, scratch + 192);
+        noc_async_read_barrier();
+        store_element(scratch, batch, (a_column + head) % 32, get_write_ptr(cb_a));
+        store_element(scratch + 64, batch, (b_column + head) % 32, get_write_ptr(cb_b));
+        store_element(scratch + 128, 0, head % 32, get_write_ptr(cb_dt));
+        store_element(scratch + 192, 0, head % 32, get_write_ptr(cb_na));
+
+        cb_push_back(cb_q, key_tiles);
+        cb_push_back(cb_k, key_tiles);
+        cb_push_back(cb_v, val_tiles);
+        cb_push_back(cb_z, val_tiles);
+        cb_push_back(cb_a, 1);
+        cb_push_back(cb_b, 1);
+        cb_push_back(cb_dt, 1);
+        cb_push_back(cb_na, 1);
+        cb_push_back(cb_state, state_tiles);
+    }
+}
