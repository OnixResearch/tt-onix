--- /dev/null
+++ b/models/demos/blackhole/qwen36/tt/gdn/decode_step.py
@@ -0,0 +1,365 @@
+"""Fused GDN decode step for the TP qwen36 decode path.
+
+Two custom programs replace the composite decode chain between the qkvzab projection and the
+out projection:
+
+* ``conv_prep``: depthwise causal conv + SiLU over the q/k/v channels, SiLU over the gate, and
+  an fp32 copy of the a/b logits, into one persistent fp32 prep buffer. It also shifts the
+  conv state in place.
+* ``recurrence``: per (batch, value head) L2 norms, beta/decay scalars, the gated delta rule
+  state update, the output read, and the gated RMSNorm, into one persistent bf16 buffer laid out
+  as the out projection's input. It updates the recurrent state in place.
+
+Both programs run through ``ttnn.generic_op`` with kernels JIT-compiled from ``kernels/``.
+"""
+
+# r[impl tenstorrent.qwen38_p150x2.gdn_decode_step]
+
+from __future__ import annotations
+
+import struct
+from dataclasses import dataclass
+from pathlib import Path
+
+import torch
+import ttnn
+
+KERNEL_DIR = Path(__file__).resolve().parent / "kernels"
+TILE = 32
+FP32_TILE_BYTES = TILE * TILE * 4
+BF16_TILE_BYTES = TILE * TILE * 2
+
+
+def _f32_bits(value: float) -> int:
+    return struct.unpack("<I", struct.pack("<f", value))[0]
+
+
+@dataclass(frozen=True)
+class GdnDecodeGeometry:
+    num_k_heads: int
+    num_v_heads: int
+    head_k_dim: int
+    head_v_dim: int
+    max_batch: int
+
+    @property
+    def key_dim(self) -> int:
+        return self.num_k_heads * self.head_k_dim
+
+    @property
+    def value_dim(self) -> int:
+        return self.num_v_heads * self.head_v_dim
+
+    @property
+    def qkv_dim(self) -> int:
+        return 2 * self.key_dim + self.value_dim
+
+    @property
+    def qkvzab_dim(self) -> int:
+        return self.qkv_dim + self.value_dim + 2 * self.num_v_heads
+
+    @property
+    def prep_tiles(self) -> int:
+        return -(-self.qkvzab_dim // TILE)
+
+    def validate(self) -> None:
+        if self.head_k_dim != 128 or self.head_v_dim != 128:
+            raise ValueError("fused GDN decode step requires 128-wide key and value heads")
+        if self.num_v_heads % self.num_k_heads:
+            raise ValueError("value heads must be a multiple of key heads")
+        if not 1 <= self.max_batch <= TILE:
+            raise ValueError("fused GDN decode step supports 1..32 batch rows")
+        if self.qkv_dim % TILE or self.value_dim % TILE:
+            raise ValueError("q/k/v and gate widths must be tile aligned")
+        if (self.qkv_dim + self.value_dim) // TILE + 2 < self.prep_tiles:
+            raise ValueError("a/b logits must fit in two tiles after the gate")
+
+
+def _cores(mesh, count: int) -> list[ttnn.CoreCoord]:
+    grid = mesh.compute_with_storage_grid_size()
+    if count > grid.x * grid.y:
+        raise ValueError("requested more cores than the compute grid")
+    return [ttnn.CoreCoord(index // grid.y, index % grid.y) for index in range(count)]
+
+
+def _core_range_set(cores: list[ttnn.CoreCoord]) -> ttnn.CoreRangeSet:
+    """Column-major core list as rectangles, so dispatch multicasts instead of unicasting."""
+    columns: dict[int, list[int]] = {}
+    for core in cores:
+        columns.setdefault(core.x, []).append(core.y)
+    ranges = []
+    full = [x for x, ys in columns.items() if ys == list(range(len(ys))) and len(ys) == max(map(len, columns.values()))]
+    if full:
+        ranges.append(ttnn.CoreRange(ttnn.CoreCoord(min(full), 0), ttnn.CoreCoord(max(full), len(columns[full[0]]) - 1)))
+    for x, ys in columns.items():
+        if x not in full:
+            ranges.append(ttnn.CoreRange(ttnn.CoreCoord(x, min(ys)), ttnn.CoreCoord(x, max(ys))))
+    return ttnn.CoreRangeSet(ranges)
+
+
+def _cb(index: int, pages: int, dtype, page_bytes: int, cores: ttnn.CoreRangeSet) -> ttnn.CBDescriptor:
+    return ttnn.CBDescriptor(
+        total_size=pages * page_bytes,
+        core_ranges=cores,
+        format_descriptors=[ttnn.CBFormatDescriptor(buffer_index=index, data_format=dtype, page_size=page_bytes)],
+    )
+
+
+def _accessor_args(*tensors) -> list[int]:
+    args: list[int] = []
+    for tensor in tensors:
+        args.extend(ttnn.TensorAccessorArgs(tensor).get_compile_time_args())
+    return args
+
+
+NUM_CIRCULAR_BUFFERS = 64
+
+
+def _compute_config(exact_cbs: tuple[int, ...] = ()) -> ttnn.ComputeConfigDescriptor:
+    config = ttnn.ComputeConfigDescriptor(
+        math_fidelity=ttnn.MathFidelity.HiFi4,
+        math_approx_mode=False,
+        fp32_dest_acc_en=True,
+    )
+    if exact_cbs:
+        modes = [ttnn.UnpackToDestMode.Default] * NUM_CIRCULAR_BUFFERS
+        for index in exact_cbs:
+            modes[index] = ttnn.UnpackToDestMode.UnpackToDestFp32
+        config.unpack_to_dest_mode = modes
+    return config
+
+
+# Step CBs unpacked straight to fp32 DEST (never through the tf32 source registers).
+EXACT_STEP_CBS = (2, 3, 8, 9, 11, 12, 20, 26, 27)
+
+
+class GdnDecodeStep:
+    """Persistent buffers and program builders for one mesh and batch capacity.
+
+    The prep and gated buffers are shared by every GDN layer on the mesh: each layer consumes
+    them before the next layer's programs run on the same queue.
+    """
+
+    def __init__(self, mesh, geometry: GdnDecodeGeometry):
+        geometry.validate()
+        self.mesh = mesh
+        self.geometry = geometry
+        replicate = ttnn.ReplicateTensorToMesh(mesh)
+        # DRAM, not L1: 0.5 us per layer slower in decode, but it keeps this resident
+        # buffer out of the L1 that prefill intermediates need.
+        self.prep = ttnn.from_torch(
+            torch.zeros(1, geometry.max_batch, geometry.prep_tiles * TILE, dtype=torch.float32),
+            dtype=ttnn.float32,
+            layout=ttnn.TILE_LAYOUT,
+            device=mesh,
+            memory_config=ttnn.DRAM_MEMORY_CONFIG,
+            mesh_mapper=replicate,
+        )
+        # Zero padding rows are part of the contract: the kernel only writes rows < batch.
+        self.gated = ttnn.from_torch(
+            torch.zeros(1, geometry.max_batch, geometry.value_dim, dtype=torch.bfloat16),
+            dtype=ttnn.bfloat16,
+            layout=ttnn.TILE_LAYOUT,
+            device=mesh,
+            memory_config=ttnn.L1_MEMORY_CONFIG,
+            mesh_mapper=replicate,
+        )
+
+    def gated_rows(self, batch: int):
+        """The gated output as [1, batch, value_dim]: a view, since padding keeps one tile row."""
+        if batch == self.geometry.max_batch:
+            return self.gated
+        padded = list(self.gated.padded_shape)
+        return ttnn.reshape(self.gated, [1, batch, self.geometry.value_dim], padded)
+
+    def layer_constants(self, tw) -> dict:
+        """fp32 per-head scalars and a row-broadcast gated-norm weight for one layer."""
+        g = self.geometry
+        norm_w = ttnn.to_torch(ttnn.get_device_tensors(tw["norm_w"])[0]).float().reshape(-1)[: g.head_v_dim]
+        return {
+            "dt": ttnn.typecast(tw["dt_bias"], ttnn.float32),
+            "neg_exp_a": ttnn.typecast(tw["neg_exp_A"], ttnn.float32),
+            "norm_w": ttnn.from_torch(
+                norm_w.reshape(1, 1, g.head_v_dim).expand(1, TILE, g.head_v_dim).contiguous(),
+                dtype=ttnn.float32,
+                layout=ttnn.TILE_LAYOUT,
+                device=self.mesh,
+                memory_config=ttnn.DRAM_MEMORY_CONFIG,
+                mesh_mapper=ttnn.ReplicateTensorToMesh(self.mesh),
+            ),
+        }
+
+    def conv_prep(self, qkvzab, conv_states, conv_taps):
+        g = self.geometry
+        tiles = g.prep_tiles
+        grid = self.mesh.compute_with_storage_grid_size()
+        per_core = -(-tiles // (grid.x * grid.y))
+        cores = _cores(self.mesh, -(-tiles // per_core))
+        core_set = _core_range_set(cores)
+        reader_rt = ttnn.RuntimeArgs()
+        compute_rt = ttnn.RuntimeArgs()
+        writer_rt = ttnn.RuntimeArgs()
+        addresses = [qkvzab.buffer_address()] + [t.buffer_address() for t in conv_states] + [
+            t.buffer_address() for t in conv_taps
+        ]
+        for index, core in enumerate(cores):
+            start = index * per_core
+            count = min(per_core, tiles - start)
+            reader_rt[core.x][core.y] = addresses + [start, count]
+            compute_rt[core.x][core.y] = [start, count]
+            writer_rt[core.x][core.y] = [self.prep.buffer_address(), start, count]
+        conv_tiles = g.qkv_dim // TILE
+        gate_end = (g.qkv_dim + g.value_dim) // TILE
+        reader = ttnn.KernelDescriptor(
+            kernel_source=str(KERNEL_DIR / "conv_reader.cpp"),
+            core_ranges=core_set,
+            compile_time_args=[conv_tiles] + _accessor_args(qkvzab, *conv_states, *conv_taps),
+            runtime_args=reader_rt,
+            config=ttnn.ReaderConfigDescriptor(),
+        )
+        compute = ttnn.KernelDescriptor(
+            kernel_source=str(KERNEL_DIR / "conv_compute.cpp"),
+            core_ranges=core_set,
+            compile_time_args=[conv_tiles, gate_end],
+            runtime_args=compute_rt,
+            config=_compute_config(),
+        )
+        writer = ttnn.KernelDescriptor(
+            kernel_source=str(KERNEL_DIR / "conv_writer.cpp"),
+            core_ranges=core_set,
+            compile_time_args=_accessor_args(self.prep),
+            runtime_args=writer_rt,
+            config=ttnn.WriterConfigDescriptor(),
+        )
+        cbs = [_cb(index, 2, ttnn.bfloat16, BF16_TILE_BYTES, core_set) for index in range(8)]
+        cbs.append(_cb(16, 2, ttnn.float32, FP32_TILE_BYTES, core_set))
+        program = ttnn.ProgramDescriptor(kernels=[reader, compute, writer], semaphores=[], cbs=cbs)
+        return ttnn.generic_op([qkvzab, *conv_states, *conv_taps, self.prep], program)
+
+    def recurrence(self, state, constants, batch: int):
+        g = self.geometry
+        if not 1 <= batch <= g.max_batch:
+            raise ValueError("decode width exceeds the fused step batch capacity")
+        instances = batch * g.num_v_heads
+        grid = self.mesh.compute_with_storage_grid_size()
+        per_core = -(-instances // (grid.x * grid.y))
+        cores = _cores(self.mesh, -(-instances // per_core))
+        core_set = _core_range_set(cores)
+        reader_rt = ttnn.RuntimeArgs()
+        compute_rt = ttnn.RuntimeArgs()
+        writer_rt = ttnn.RuntimeArgs()
+        reader_addresses = [
+            self.prep.buffer_address(),
+            state.buffer_address(),
+            constants["dt"].buffer_address(),
+            constants["neg_exp_a"].buffer_address(),
+            constants["norm_w"].buffer_address(),
+        ]
+        for index, core in enumerate(cores):
+            start = index * per_core
+            count = min(per_core, instances - start)
+            reader_rt[core.x][core.y] = reader_addresses + [start, count]
+            compute_rt[core.x][core.y] = [count]
+            writer_rt[core.x][core.y] = [self.gated.buffer_address(), state.buffer_address(), start, count]
+        key_tiles = g.head_k_dim // TILE
+        val_tiles = g.head_v_dim // TILE
+        reader = ttnn.KernelDescriptor(
+            kernel_source=str(KERNEL_DIR / "step_reader.cpp"),
+            core_ranges=core_set,
+            compile_time_args=[
+                key_tiles,
+                val_tiles,
+                g.num_v_heads // g.num_k_heads,
+                g.num_v_heads,
+                0,
+                g.key_dim // TILE,
+                2 * g.key_dim // TILE,
+                g.qkv_dim // TILE,
+                g.qkv_dim + g.value_dim,
+                g.qkv_dim + g.value_dim + g.num_v_heads,
+            ]
+            + _accessor_args(self.prep, state, constants["dt"], constants["neg_exp_a"], constants["norm_w"]),
+            runtime_args=reader_rt,
+            config=ttnn.ReaderConfigDescriptor(),
+        )
+        compute = ttnn.KernelDescriptor(
+            kernel_source=str(KERNEL_DIR / "step_compute.cpp"),
+            core_ranges=core_set,
+            compile_time_args=[
+                key_tiles,
+                val_tiles,
+                _f32_bits(g.head_k_dim**-0.5),
+                _f32_bits(1.0 / g.head_v_dim),
+            ],
+            runtime_args=compute_rt,
+            config=_compute_config(EXACT_STEP_CBS),
+        )
+        writer = ttnn.KernelDescriptor(
+            kernel_source=str(KERNEL_DIR / "step_writer.cpp"),
+            core_ranges=core_set,
+            compile_time_args=[key_tiles, val_tiles, g.num_v_heads] + _accessor_args(self.gated, state),
+            runtime_args=writer_rt,
+            config=ttnn.WriterConfigDescriptor(),
+        )
+        state_tiles = key_tiles * val_tiles
+        fp32_cbs = {
+            0: key_tiles, 1: key_tiles, 2: val_tiles, 3: val_tiles,  # q k v silu(z)
+            4: 1, 5: 1, 6: 1, 7: 1,  # a b dt -exp(A)
+            8: state_tiles, 9: val_tiles, 10: 1,  # state, norm weight, scratch
+            11: 1, 12: 1, 13: 1, 14: 1,  # beta decay 1/|k| scale/|q|
+            15: key_tiles, 17: key_tiles, 18: key_tiles,  # k q k^T
+            19: state_tiles, 20: val_tiles, 21: val_tiles, 22: state_tiles,  # S' v_read delta*beta S
+            23: val_tiles, 24: 1, 26: state_tiles, 27: val_tiles,  # o 1/rms(o) exact S' exact o
+        }
+        cbs = [_cb(index, pages, ttnn.float32, FP32_TILE_BYTES, core_set) for index, pages in fp32_cbs.items()]
+        cbs.append(_cb(16, val_tiles, ttnn.bfloat16, BF16_TILE_BYTES, core_set))
+        program = ttnn.ProgramDescriptor(kernels=[reader, compute, writer], semaphores=[], cbs=cbs)
+        io = [self.prep, state, constants["dt"], constants["neg_exp_a"], constants["norm_w"], self.gated]
+        return ttnn.generic_op(io, program)
+
+
+_STEPS: dict[tuple[int, GdnDecodeGeometry], GdnDecodeStep] = {}
+
+
+def shared_step(mesh, geometry: GdnDecodeGeometry) -> GdnDecodeStep:
+    """One set of persistent buffers per mesh and geometry."""
+    key = (id(mesh), geometry)
+    step = _STEPS.get(key)
+    if step is None:
+        step = GdnDecodeStep(mesh, geometry)
+        _STEPS[key] = step
+    return step
+
+
+def reference_step(qkvzab, conv_states, taps, state, dt, neg_exp_a, norm_w, geometry, batch):
+    """float64 reference of one fused decode step. Returns (gated, new_conv_states, new_state)."""
+    g = geometry
+    x = qkvzab[:batch].double()
+    qkv = x[:, : g.qkv_dim]
+    z = x[:, g.qkv_dim : g.qkv_dim + g.value_dim]
+    a = x[:, g.qkv_dim + g.value_dim : g.qkv_dim + g.value_dim + g.num_v_heads]
+    b = x[:, g.qkv_dim + g.value_dim + g.num_v_heads : g.qkvzab_dim]
+    s = [c[:batch].double() for c in conv_states]
+    t = [tap.double() for tap in taps]
+    conv = torch.nn.functional.silu(s[1] * t[0] + s[2] * t[1] + s[3] * t[2] + qkv * t[3])
+    new_conv = [s[1], s[2], s[3], qkv]
+    kd = g.key_dim
+    rf = g.num_v_heads // g.num_k_heads
+    q = conv[:, :kd].reshape(batch, g.num_k_heads, g.head_k_dim).repeat_interleave(rf, dim=1)
+    k = conv[:, kd : 2 * kd].reshape(batch, g.num_k_heads, g.head_k_dim).repeat_interleave(rf, dim=1)
+    v = conv[:, 2 * kd :].reshape(batch, g.num_v_heads, g.head_v_dim)
+    q = q * torch.rsqrt((q * q).sum(-1, keepdim=True) + 1e-6) * g.head_k_dim**-0.5
+    k = k * torch.rsqrt((k * k).sum(-1, keepdim=True) + 1e-6)
+    beta = torch.sigmoid(b)
+    decay = torch.exp(neg_exp_a.double() * torch.nn.functional.softplus(a + dt.double()))
+    h = state[:batch].double() * decay[..., None, None]
+    v_read = torch.einsum("bhk,bhkv->bhv", k, h)
+    delta = (v - v_read) * beta[..., None]
+    h = h + torch.einsum("bhk,bhv->bhkv", k, delta)
+    o = torch.einsum("bhk,bhkv->bhv", q, h)
+    o = o * torch.rsqrt((o * o).mean(-1, keepdim=True) + 1e-6) * norm_w.double()
+    gated = (o * torch.nn.functional.silu(z.reshape(batch, g.num_v_heads, g.head_v_dim))).reshape(batch, -1)
+    return gated, new_conv, h
+
+
+__all__ = ["GdnDecodeGeometry", "GdnDecodeStep", "shared_step", "reference_step"]
