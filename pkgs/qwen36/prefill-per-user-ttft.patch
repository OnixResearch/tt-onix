+    def _probe_masked_slot_logits(self, slot):
+        """Block until `slot`'s masked-prefill logits row is written.
+
+        One-element read of the row's first column, not the [32, vocab] tile: a full
+        readback per user would copy megabytes and distort the per-user timing. The read is
+        enqueued after the replay on the same queue, so it completes only once that replay
+        has finished. The probe tensor is deallocated before the next replay, because an
+        allocation left alive across a replay can sit in that trace's scratch.
+        """
+        probe = ttnn.slice(
+            self._masked_slot_logits, (0, 0, slot, 0), (1, 1, slot + 1, 1)
+        )
+        try:
+            ttnn.to_torch(ttnn.get_device_tensors(probe)[0])
+        finally:
+            ttnn.deallocate(probe)
+
