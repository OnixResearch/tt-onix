+"""Pure, device-free decode projection layout candidate for the P150x2 GDN TP path.
+
+Owns the operator gate and the shape-eligibility policy for the gated
+DRAM-sharded decode candidate. This module imports no ttnn object and opens no
+device; every rule here is domain policy, safe to exercise on a CPU-only
+interpreter.
+
+The candidate is default-off. Production keeps the tuned 1D-mcast decode
+matmul until matched eager-versus-candidate physical evidence admits the
+DRAM-sharded layout. The adopted tree only consumes ``select_decode_layout``
+and ``gate_enabled``; it never re-derives the eligibility rule.
+"""
+
+# r[impl tenstorrent.qwen38_p150x2.gdn_decode_projection_layout]
+
+import os
+
+# Operator gate. Absent or any non-listed value keeps the default path.
+ENV_GATE = "QWEN35_GDN_DECODE_LAYOUT"
+
+# The candidate layout family. The packaged default 0.74 decode path already
+# uses a 1D-mcast (multi-cast-in0) program config for the GDN TP projections
+# (gdn_qkvz_decode_1d_progcfg / gdn_out_decode_1d_progcfg), so the only
+# non-default family this change can offer is DRAM-sharded decode.
+LAYOUT_DRAM_SHARDED = "dram_sharded"
+
+# Fail closed: only explicit truthy spellings enable the candidate.
+_ENABLED_VALUES = frozenset({"1", "true", "True", "yes", "on"})
+
+# Tile width for the matmul K eligibility check.
+TILE_SIZE = 32
+
+
+def gate_enabled(env=None):
+    """Return True only for an explicit enable value.
+
+    env: a mapping (usually os.environ). The candidate must default off; a
+    missing, empty, or unrecognized value never enables it.
+    """
+    if env is None:
+        env = os.environ
+    value = env.get(ENV_GATE, "")
+    if not isinstance(value, str):
+        return False
+    return value.strip() in _ENABLED_VALUES
+
+
+def select_decode_layout(
+    activation_width,
+    projection_width,
+    decode_width,
+    grid_width,
+    enabled,
+):
+    """Return ``LAYOUT_DRAM_SHARDED`` for an eligible decode projection, else None.
+
+    This is the pure shape-eligibility policy. It accepts only a single-token
+    decode (decode_width == 1), a tile-aligned activation K, and a positive
+    projection N on a non-degenerate worker grid. N needs no tile alignment:
+    the matmul pads N to the next tile width, so the real per-device qkvzab
+    width (8240, mid-tile at the a/b tail) is legal. None means the consumer
+    keeps the production 1D-mcast path.
+
+    activation_width: K of the projection (per-device hidden width).
+    projection_width: N of the projection (per-device qkvzab width).
+    decode_width: token count for this projection (1 in decode).
+    grid_width: available worker-grid width (columns) on the device.
+    enabled: the boolean result of ``gate_enabled``.
+    """
+    if not enabled:
+        return None
+    if decode_width != 1:
+        return None
+    if not isinstance(activation_width, int) or activation_width <= 0:
+        return None
+    if activation_width % TILE_SIZE != 0:
+        return None
+    if not isinstance(projection_width, int) or projection_width <= 0:
+        return None
+    if not isinstance(grid_width, int) or grid_width < 1:
+        return None
+    return LAYOUT_DRAM_SHARDED
