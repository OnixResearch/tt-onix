+            self._unbind_gdn_prefill_scratch(prev)
+        self._masked_prefill_traces = traces
+        self._masked_prefill_program_entries = self.mesh_device.num_program_cache_entries()
+
+    def release_masked_prefill_traces(self):
+        """Release every masked prefill trace and its persistent inputs."""
+        for bufs in (getattr(self, "_masked_prefill_traces", None) or {}).values():
+            if bufs.get("trace_id") is not None:
+                ttnn.release_trace(self.device, bufs["trace_id"])
+            for key in ("token", "full_pt", "chunk_pt", "csi", "cos", "sin", "sel", "mask", "logit_sel", "output"):
+                if bufs.get(key) is not None:
