+                conv = [[ttnn.clone(c) for c in dn.conv_states] for dn in dn_states]
+                self._unbind_gdn_prefill_scratch(prev)
+                self._write_gdn_slot_device(slot, rec, conv)
+                prev = self._bind_gdn_prefill_scratch()
