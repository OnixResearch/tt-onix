diff --git a/models/demos/blackhole/qwen36/tt/gdn/kernels/slot_install.cpp b/models/demos/blackhole/qwen36/tt/gdn/kernels/slot_install.cpp
new file mode 100644
--- /dev/null
+++ b/models/demos/blackhole/qwen36/tt/gdn/kernels/slot_install.cpp
@@ -0,0 +1,73 @@
+// SPDX-License-Identifier: Apache-2.0
+// Masked prefill slot install: copies one user's prefill state into its decode slot.
+//
+// The slot index is read from a device buffer, so a captured trace installs into whichever
+// slot the host staged before the replay. Each chunk is either
+//   kind 0 (slab): tile t of the source goes to tile slot * slab_tiles + t of the destination;
+//   kind 1 (row):  row 0 of source tile t replaces row `slot` of destination tile t.
+// All tensors are DRAM-interleaved TILE layout. Tiles are 32x32 in four 16x16 faces.
+
+#include <stdint.h>
+
+#include "api/dataflow/dataflow_api.h"
+
+void kernel_main() {
+    constexpr auto dram_args = TensorAccessorArgs<0>();
+    constexpr uint32_t slot_page_bytes = get_compile_time_arg_val(dram_args.next_compile_time_args_offset());
+    constexpr uint32_t cb_src = 0;
+    constexpr uint32_t cb_dst = 1;
+    constexpr uint32_t face_rows = 16;
+
+    uint32_t arg = 0;
+    const uint32_t slot_addr = get_arg_val<uint32_t>(arg++);
+    const uint32_t chunk_count = get_arg_val<uint32_t>(arg++);
+
+    const uint32_t src_l1 = get_write_ptr(cb_src);
+    const uint32_t dst_l1 = get_write_ptr(cb_dst);
+
+    const auto slot_reader = TensorAccessor(dram_args, slot_addr, slot_page_bytes);
+    noc_async_read(slot_reader.get_noc_addr(0), src_l1, slot_page_bytes);
+    noc_async_read_barrier();
+    const uint32_t slot = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(src_l1)[0];
+    const uint32_t row_half = slot / face_rows;
+    const uint32_t row_in_face = slot % face_rows;
+
+    for (uint32_t chunk = 0; chunk < chunk_count; chunk++) {
+        const uint32_t kind = get_arg_val<uint32_t>(arg++);
+        const uint32_t src_addr = get_arg_val<uint32_t>(arg++);
+        const uint32_t dst_addr = get_arg_val<uint32_t>(arg++);
+        const uint32_t tile_bytes = get_arg_val<uint32_t>(arg++);
+        const uint32_t elem_bytes = get_arg_val<uint32_t>(arg++);
+        const uint32_t slab_tiles = get_arg_val<uint32_t>(arg++);
+        const uint32_t start = get_arg_val<uint32_t>(arg++);
+        const uint32_t count = get_arg_val<uint32_t>(arg++);
+
+        const auto src = TensorAccessor(dram_args, src_addr, tile_bytes);
+        const auto dst = TensorAccessor(dram_args, dst_addr, tile_bytes);
+        const uint32_t row_words = face_rows * elem_bytes / sizeof(uint32_t);
+        const uint32_t face_bytes = face_rows * face_rows * elem_bytes;
+
+        for (uint32_t tile = start; tile < start + count; tile++) {
+            noc_async_read(src.get_noc_addr(tile), src_l1, tile_bytes);
+            if (kind == 0) {
+                noc_async_read_barrier();
+                noc_async_write(src_l1, dst.get_noc_addr(slot * slab_tiles + tile), tile_bytes);
+                noc_async_write_barrier();
+                continue;
+            }
+            noc_async_read(dst.get_noc_addr(tile), dst_l1, tile_bytes);
+            noc_async_read_barrier();
+            for (uint32_t half = 0; half < 2; half++) {
+                volatile tt_l1_ptr uint32_t* from =
+                    reinterpret_cast<volatile tt_l1_ptr uint32_t*>(src_l1 + half * face_bytes);
+                volatile tt_l1_ptr uint32_t* to = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(
+                    dst_l1 + (2 * row_half + half) * face_bytes + row_in_face * row_words * sizeof(uint32_t));
+                for (uint32_t word = 0; word < row_words; word++) {
+                    to[word] = from[word];
+                }
+            }
+            noc_async_write(dst_l1, dst.get_noc_addr(tile), tile_bytes);
+            noc_async_write_barrier();
+        }
+    }
+}
