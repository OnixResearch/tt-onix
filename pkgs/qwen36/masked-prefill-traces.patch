+    def _lm_head_width(self):
+        """Width of the replicated LM-head output (the gathered, padded vocabulary)."""
+        width = int(self.lm_head_weight.shape[-1])
+        return width * self.num_devices if self._lmhead_vocab_sharded else width
+
+    def _alloc_masked_prefill_inputs(self, bucket, page_table_row):
+        """Persistent replicated inputs for one masked prefill trace."""
+        from models.experimental.gated_attention_gated_deltanet.tt.ttnn_delta_rule_seq import seq_valid_mask
+        from models.experimental.gated_attention_gated_deltanet.tt.ttnn_gated_deltanet import conv_valid_selector
+
+        rep = ttnn.ReplicateTensorToMesh(self.device)
+        dn = next(layer.attention for layer in self.layers if not layer.is_full_attention)
