new file mode 100644
--- /dev/null
+++ b/models/demos/blackhole/qwen36/tt/gdn/slot_install.py
@@ -0,0 +1,142 @@
+"""Traced install of one user's prefill state and logits into its decode slot.
+
+A masked prefill trace leaves the user's GDN state in the B=1 prefill scratch and its
+next-token logits in a one-row tensor. This program copies both into row ``slot`` of the
+batched decode buffers and of a per-slot logits buffer. The slot index is read from a device
+buffer, so one captured trace serves every slot and the host issues no per-user install ops.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+
+import ttnn
+
+KERNEL = Path(__file__).resolve().parent / "kernels" / "slot_install.cpp"
+TILE = 32
+SLAB = 0
+ROW = 1
+# Tiles per chunk: bounds each core's runtime arguments and balances the cores.
+CHUNK_TILES = 256
+# A row copy reads two tiles and writes one; a slab copy reads one and writes one.
+COST = {SLAB: 2, ROW: 3}
+
+
+@dataclass(frozen=True)
+class Copy:
+    kind: int
+    source: ttnn.Tensor
+    destination: ttnn.Tensor
+    slab_tiles: int = 0
+
+
+def _tiles(tensor) -> int:
+    shape = list(tensor.padded_shape)
+    return (shape[-2] // TILE) * (shape[-1] // TILE) * _outer(shape)
+
+
+def _outer(shape) -> int:
+    count = 1
+    for dim in shape[:-2]:
+        count *= dim
+    return count
+
+
+def _element_bytes(tensor) -> int:
+    if tensor.dtype == ttnn.float32:
+        return 4
+    if tensor.dtype == ttnn.bfloat16:
+        return 2
+    raise ValueError(f"slot install supports float32 and bfloat16 tiles, got {tensor.dtype}")
+
+
+def _require_dram_tile(tensor) -> None:
+    if tensor.layout != ttnn.TILE_LAYOUT:
+        raise ValueError("slot install copies TILE tensors")
+    config = tensor.memory_config()
+    if config.buffer_type != ttnn.BufferType.DRAM or config.is_sharded():
+        raise ValueError("slot install copies DRAM-interleaved tensors")
+
+
+def slab(source, destination) -> Copy:
+    """Every tile of ``source`` lands in slot ``slot`` of ``destination``'s leading dimension."""
+    tiles = _tiles(source)
+    if _tiles(destination) % tiles:
+        raise ValueError("destination is not a whole number of source slabs")
+    return Copy(SLAB, source, destination, tiles)
+
+
+def row(source, destination) -> Copy:
+    """Row 0 of ``source`` replaces row ``slot`` of ``destination`` (one tile row each)."""
+    if _tiles(source) != _tiles(destination) or _outer(list(source.padded_shape)) * (
+        source.padded_shape[-2] // TILE
+    ) != 1:
+        raise ValueError("row copies need matching single-tile-row tensors")
+    return Copy(ROW, source, destination)
+
+
+def install(mesh, slot_buffer, copies: list[Copy]):
+    """Run the copies on the worker grid; ``slot_buffer`` holds the slot as its first uint32."""
+    chunks = []
+    for copy in copies:
+        for tensor in (copy.source, copy.destination):
+            _require_dram_tile(tensor)
+        if copy.source.dtype != copy.destination.dtype:
+            raise ValueError("slot install does not convert dtypes")
+        element = _element_bytes(copy.source)
+        tile_bytes = TILE * TILE * element
+        tiles = _tiles(copy.source)
+        for start in range(0, tiles, CHUNK_TILES):
+            count = min(CHUNK_TILES, tiles - start)
+            chunks.append(
+                (
+                    COST[copy.kind] * count,
+                    [
+                        copy.kind,
+                        copy.source.buffer_address(),
+                        copy.destination.buffer_address(),
+                        tile_bytes,
+                        element,
+                        copy.slab_tiles,
+                        start,
+                        count,
+                    ],
+                )
+            )
+    grid = mesh.compute_with_storage_grid_size()
+    core_count = min(grid.x * grid.y, len(chunks))
+    cores = [ttnn.CoreCoord(index % grid.x, index // grid.x) for index in range(core_count)]
+    loads = [0] * core_count
+    assigned: list[list[int]] = [[] for _ in range(core_count)]
+    for cost, args in sorted(chunks, key=lambda item: -item[0]):
+        target = loads.index(min(loads))
+        loads[target] += cost
+        assigned[target].extend(args)
+    runtime = ttnn.RuntimeArgs()
+    for core, args in zip(cores, assigned):
+        runtime[core.x][core.y] = [slot_buffer.buffer_address(), len(args) // 8] + args
+    core_set = ttnn.CoreRangeSet([ttnn.CoreRange(core, core) for core in cores])
+    slot_page_bytes = slot_buffer.padded_shape[-1] * 4
+    kernel = ttnn.KernelDescriptor(
+        kernel_source=str(KERNEL),
+        core_ranges=core_set,
+        compile_time_args=list(ttnn.TensorAccessorArgs(slot_buffer).get_compile_time_args()) + [slot_page_bytes],
+        runtime_args=runtime,
+        config=ttnn.ReaderConfigDescriptor(),
+    )
+    page = TILE * TILE * 4
+    cbs = [
+        ttnn.CBDescriptor(
+            total_size=page,
+            core_ranges=core_set,
+            format_descriptors=[ttnn.CBFormatDescriptor(buffer_index=index, data_format=ttnn.float32, page_size=page)],
+        )
+        for index in (0, 1)
+    ]
+    program = ttnn.ProgramDescriptor(kernels=[kernel], semaphores=[], cbs=cbs)
+    io = [slot_buffer]
+    for copy in copies:
+        io.extend((copy.source, copy.destination))
+    # generic_op writes its result into the last tensor; the destinations are updated in place.
+    return ttnn.generic_op(io, program)
