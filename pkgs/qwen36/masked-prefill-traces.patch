+
+    def warm_serving_programs(self, page_table, chunked_lengths=(1100, 1152, 1200, 1280, 1300, 1536, 1700)):
+        """Compile the eager prefill and decode-slot programs serving can reach besides the traces.
+
+        Masked prefill traces must be captured after every program serving will run: eager
+        masked buckets up to EAGER_PREFILL_CHUNK_TOKENS (masked and full), chunked prompts with
+        carried state (tails in every bucket), and the per-slot GDN state installs.
+        page_table: torch [slots, W] int32, one row per decode slot; W covers every bucket."""
+        buckets = tuple(b for b in self._PREFILL_MASK_BUCKETS if b <= EAGER_PREFILL_CHUNK_TOKENS)
+        row = page_table[:1].contiguous()
+        dn_states = [layer.attention for layer in self.layers if not layer.is_full_attention]
+        prev = self._bind_gdn_prefill_scratch()
