+"""Pure policy for the default-off GDN decode fusion candidate.
+
+``norm`` folds fixed Q/K scales into RMSNorm. ``state`` uses the TTNN
+ternary state update. ``full`` selects the fused fp32 recurrent kernel.
+
+This module imports no TTNN object and opens no device.
+"""
+
+import os
+
+# r[impl tenstorrent.qwen38_p150x2.gdn_decode_fusion]
+
+ENV_GATE = "QWEN35_GDN_DECODE_FUSION"
+MODE_OFF = "off"
+MODE_NORM = "norm"
+MODE_STATE = "state"
+MODE_FULL = "full"
+MODES = frozenset({MODE_OFF, MODE_NORM, MODE_STATE, MODE_FULL})
+
+
+def selected_mode(env=None):
+    """Return a closed mode. Missing or unknown values select ``off``."""
+    if env is None:
+        env = os.environ
+    value = env.get(ENV_GATE, MODE_OFF)
+    if not isinstance(value, str):
+        return MODE_OFF
+    mode = value.strip().lower()
+    return mode if mode in MODES else MODE_OFF
+
+
+def uses_fused_norm(mode):
+    """Return whether ``mode`` folds Q/K scale into RMSNorm."""
+    return mode in {MODE_NORM, MODE_FULL}
+
+
+def uses_fused_state_update(mode):
+    """Return whether ``mode`` uses one addcmul state-update kernel."""
+    return mode == MODE_STATE
+
+
+def uses_fused_recurrence(mode):
+    """Return whether ``mode`` uses the custom fp32 recurrence."""
+    return mode == MODE_FULL
