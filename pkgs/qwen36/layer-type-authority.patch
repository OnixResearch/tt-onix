 GDN_CONV1D_L1_SMALL_SIZE = 24576
+LINEAR_ATTENTION_TYPE = "linear_attention"
+FULL_ATTENTION_TYPE = "full_attention"
+SUPPORTED_ATTENTION_TYPES = frozenset((LINEAR_ATTENTION_TYPE, FULL_ATTENTION_TYPE))
+LEGACY_QWEN35_9B_LAYER_GROUP = (
+    LINEAR_ATTENTION_TYPE,
+    LINEAR_ATTENTION_TYPE,
+    LINEAR_ATTENTION_TYPE,
+    FULL_ATTENTION_TYPE,
+)
+LEGACY_QWEN35_9B_LAYER_GROUP_COUNT = 8
+LEGACY_QWEN35_9B_LAYER_TYPES = (
+    LEGACY_QWEN35_9B_LAYER_GROUP * LEGACY_QWEN35_9B_LAYER_GROUP_COUNT
+)
+
+
+class LayerTypeAuthorityError(ValueError):
+    """The checkpoint does not provide valid hybrid-layer authority."""
+
+
+# r[impl tenstorrent.qwen38_p150x2.layer_type_authority]
+def resolve_attention_type_list(layer_types, layer_count: int) -> tuple[str, ...]:
+    """Return complete checkpoint-owned mixer types or the exact legacy fallback."""
+    if not isinstance(layer_count, int) or isinstance(layer_count, bool) or layer_count <= 0:
+        raise LayerTypeAuthorityError("layer count must be a positive integer")
+
+    if layer_types is None:
+        if layer_count != len(LEGACY_QWEN35_9B_LAYER_TYPES):
+            raise LayerTypeAuthorityError(
+                "checkpoint layer_types is required when the declared layer count "
+                "does not match the legacy Qwen3.5-9B fallback"
+            )
+        resolved = LEGACY_QWEN35_9B_LAYER_TYPES
+    else:
+        if not isinstance(layer_types, (list, tuple)):
+            raise LayerTypeAuthorityError("checkpoint layer_types must be a list or tuple")
+        resolved = tuple(layer_types)
+
+    if len(resolved) != layer_count:
+        raise LayerTypeAuthorityError(
+            f"checkpoint layer_types has {len(resolved)} entries for {layer_count} layers"
+        )
+    for layer_index, layer_type in enumerate(resolved):
+        if layer_type not in SUPPORTED_ATTENTION_TYPES:
+            raise LayerTypeAuthorityError(
+                f"checkpoint layer_types[{layer_index}] has unknown type {layer_type!r}"
+            )
+    return resolved
 
 
 class Qwen36ModelArgs(ModelArgs):
