+#include <tt-metalium/constants.hpp>
+
+#include "ttnn/device.hpp"
+#include "ttnn/device_operation.hpp"
+#include "ttnn/operation.hpp"
+#include "ttnn/tensor/tensor_ops.hpp"
+
+using namespace tt::tt_metal;
+
+namespace ttnn::prim {
+namespace {
+
+constexpr uint32_t kRequiredHeadDim = 4 * tt::constants::TILE_HEIGHT;
+
+void validate_tensor(const Tensor& tensor, const char* name) {
+    TT_FATAL(tensor.storage_type() == StorageType::DEVICE, "{} must be on device", name);
+    TT_FATAL(tensor.buffer() != nullptr, "{} must be allocated", name);
+    TT_FATAL(tensor.layout() == Layout::TILE, "{} must use TILE layout", name);
+    TT_FATAL(tensor.dtype() == DataType::FLOAT32, "{} must be float32, got {}", name, tensor.dtype());
+    TT_FATAL(!tensor.is_sharded(), "{} must be interleaved", name);
+}
+
+void validate_shape(const Tensor& tensor, std::initializer_list<uint32_t> expected, const char* name) {
+    const auto shape = tensor.logical_shape();
+    TT_FATAL(shape.rank() == expected.size(), "{} rank mismatch: {} vs {}", name, shape.rank(), expected.size());
+    size_t index = 0;
+    for (const auto extent : expected) {
+        TT_FATAL(
+            static_cast<uint32_t>(shape[index]) == extent,
+            "{} dim[{}] expected {} got {}",
+            name,
+            index,
+            extent,
+            shape[index]);
+        index++;
+    }
+}
+
+}  // namespace
+
+void GatedDeltaDecodeDeviceOperation::validate_on_program_cache_miss(
+    const operation_attributes_t& attrs, const tensor_args_t& in) {
+    validate_tensor(in.q, "q");
+    validate_tensor(in.k, "k");
+    validate_tensor(in.v, "v");
+    validate_tensor(in.beta, "beta");
+    validate_tensor(in.g, "g");
+    validate_tensor(in.state, "state");
+    if (in.output_state.has_value()) {
+        validate_tensor(*in.output_state, "output_state");
+    }
+
+    const auto [fidelity, approximate, fp32_acc, l1_acc, full_sync] =
+        get_compute_kernel_config_args(in.q.device()->arch(), attrs.compute_kernel_config);
+    TT_FATAL(
+        fidelity == MathFidelity::HiFi4 && !approximate && fp32_acc && !l1_acc && !full_sync,
+        "gated_delta_decode requires HiFi4, exact math, fp32 accumulation, no L1 accumulation, and no full sync");
+
+    // The factory implements this one precision profile, rather than ignoring caller settings.
+    TT_FATAL(attrs.num_heads > 0, "num_heads must be positive");
+    TT_FATAL(attrs.key_dim == kRequiredHeadDim, "key_dim must be {}, got {}", kRequiredHeadDim, attrs.key_dim);
+    TT_FATAL(attrs.val_dim == kRequiredHeadDim, "val_dim must be {}, got {}", kRequiredHeadDim, attrs.val_dim);
+    TT_FATAL(!attrs.output_mem_config.is_sharded(), "output must be interleaved");
+
+    validate_shape(in.q, {attrs.num_heads, 1, attrs.key_dim}, "q");
+    validate_shape(in.k, {attrs.num_heads, 1, attrs.key_dim}, "k");
+    validate_shape(in.v, {attrs.num_heads, 1, attrs.val_dim}, "v");
+    validate_shape(in.beta, {attrs.num_heads, 1, 1}, "beta");
+    validate_shape(in.g, {attrs.num_heads, 1, 1}, "g");
+    validate_shape(in.state, {attrs.num_heads, attrs.key_dim, attrs.val_dim}, "state");
+    if (in.output_state.has_value()) {
+        validate_shape(*in.output_state, {attrs.num_heads, attrs.key_dim, attrs.val_dim}, "output_state");
+        TT_FATAL(
+            in.output_state->memory_config() == in.state.memory_config(),
+            "output_state memory config must match state for trace-safe aliasing");
+    }
+}
+
+void GatedDeltaDecodeDeviceOperation::validate_on_program_cache_hit(
+    const operation_attributes_t& attrs, const tensor_args_t& in) {
+    validate_on_program_cache_miss(attrs, in);
+}
+
+GatedDeltaDecodeDeviceOperation::spec_return_value_t GatedDeltaDecodeDeviceOperation::compute_output_specs(
+    const operation_attributes_t& attrs, const tensor_args_t& in) {
+    TensorSpec output_spec(
+        ttnn::Shape({attrs.num_heads, 1, attrs.val_dim}),
+        TensorLayout(DataType::FLOAT32, PageConfig(Layout::TILE), attrs.output_mem_config));
+    const auto state_spec = in.output_state.has_value() ? in.output_state->tensor_spec() : in.state.tensor_spec();
+    return {output_spec, state_spec};
+}
+
+GatedDeltaDecodeDeviceOperation::tensor_return_value_t GatedDeltaDecodeDeviceOperation::create_output_tensors(
+    const operation_attributes_t& attrs, const tensor_args_t& in) {
+    const auto specs = compute_output_specs(attrs, in);
+    Tensor state_output = in.output_state.has_value() ? *in.output_state : create_device_tensor(specs[1], in.state.device());
+    return {create_device_tensor(specs[0], in.q.device()), state_output};
+}
+
+ttsl::hash::hash_t GatedDeltaDecodeDeviceOperation::compute_program_hash(
+    const operation_attributes_t& attrs, const tensor_args_t& in) {
+    return operation::hash_operation<GatedDeltaDecodeDeviceOperation>(
+        attrs.num_heads,
+        attrs.key_dim,
+        attrs.val_dim,
+        attrs.output_mem_config,
+        attrs.compute_kernel_config,
+        in.q,
+        in.k,
+        in.v,
+        in.beta,
+        in.g,
+        in.state,
+        in.output_state);
+}
+
+std::vector<Tensor> gated_delta_decode(
+    const Tensor& q,
+    const Tensor& k,
+    const Tensor& v,
+    const Tensor& beta,
+    const Tensor& g,
+    const Tensor& state,
+    const std::optional<Tensor>& output_state,
+    const tt::tt_metal::MemoryConfig& output_mem_config,
+    const DeviceComputeKernelConfig& compute_kernel_config) {
+    using Operation = GatedDeltaDecodeDeviceOperation;
+    const auto q_shape = q.logical_shape();
+    return ttnn::device_operation::launch<Operation>(
+        Operation::operation_attributes_t{
+            .num_heads = static_cast<uint32_t>(q_shape[0]),
+            .key_dim = static_cast<uint32_t>(q_shape[2]),
+            .val_dim = static_cast<uint32_t>(v.logical_shape()[2]),
+            .output_mem_config = output_mem_config,
+            .compute_kernel_config = compute_kernel_config,
+        },
+        Operation::tensor_args_t{
+            .q = q,
+            .k = k,
+            .v = v,
+            .beta = beta,
+            .g = g,
+            .state = state,
+            .output_state = output_state,
+        });
+}
+
+}  // namespace ttnn::prim
