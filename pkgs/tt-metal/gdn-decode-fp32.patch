+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+
+#include "api/compute/common.h"
+#include "api/compute/matmul.h"
+#include "api/compute/eltwise_binary.h"
+#include "api/compute/eltwise_unary/eltwise_unary.h"
+#include "api/compute/eltwise_unary/exp.h"
+#include "api/compute/bcast.h"
+#include "api/compute/tile_move_copy.h"
+#include "api/compute/transpose.h"
+#include "api/compute/reconfig_data_format.h"
+#include "api/dataflow/circular_buffer.h"
+
+void kernel_main() {
+    constexpr uint32_t key_tiles = get_compile_time_arg_val(0);
+    constexpr uint32_t val_tiles = get_compile_time_arg_val(1);
+    constexpr uint32_t state_tiles = key_tiles * val_tiles;
+
+    constexpr uint32_t cb_q = tt::CBIndex::c_0;
+    constexpr uint32_t cb_k = tt::CBIndex::c_1;
+    constexpr uint32_t cb_v = tt::CBIndex::c_2;
+    constexpr uint32_t cb_beta = tt::CBIndex::c_3;
+    constexpr uint32_t cb_g = tt::CBIndex::c_4;
+    constexpr uint32_t cb_state = tt::CBIndex::c_5;
+    constexpr uint32_t cb_g_exp = tt::CBIndex::c_6;
+    constexpr uint32_t cb_state_decay = tt::CBIndex::c_7;
+    constexpr uint32_t cb_v_read = tt::CBIndex::c_8;
+    constexpr uint32_t cb_delta = tt::CBIndex::c_9;
+    constexpr uint32_t cb_k_col = tt::CBIndex::c_10;
+    constexpr uint32_t cb_outer = tt::CBIndex::c_11;
+    constexpr uint32_t cb_outer_scaled = tt::CBIndex::c_12;
+    constexpr uint32_t cb_state_new = tt::CBIndex::c_13;
+    constexpr uint32_t cb_output = tt::CBIndex::c_16;
+
+    compute_kernel_hw_startup<SrcOrder::Reverse>(cb_k, cb_state_decay, cb_v_read);
+
+    CircularBuffer q_buffer(cb_q);
+    CircularBuffer k_buffer(cb_k);
+    CircularBuffer v_buffer(cb_v);
+    CircularBuffer beta_buffer(cb_beta);
+    CircularBuffer g_buffer(cb_g);
+    CircularBuffer state_buffer(cb_state);
+    CircularBuffer g_exp_buffer(cb_g_exp);
+    CircularBuffer state_decay_buffer(cb_state_decay);
+    CircularBuffer v_read_buffer(cb_v_read);
+    CircularBuffer delta_buffer(cb_delta);
+    CircularBuffer k_col_buffer(cb_k_col);
+    CircularBuffer outer_buffer(cb_outer);
+    CircularBuffer outer_scaled_buffer(cb_outer_scaled);
+    CircularBuffer state_new_buffer(cb_state_new);
+    CircularBuffer output_buffer(cb_output);
+
+    q_buffer.wait_front(key_tiles);
+    k_buffer.wait_front(key_tiles);
+    v_buffer.wait_front(val_tiles);
+    beta_buffer.wait_front(1);
+    g_buffer.wait_front(1);
+    state_buffer.wait_front(state_tiles);
+
+    // decay = exp(g), using the accurate SFPU path.
+    g_exp_buffer.reserve_back(1);
+    init_sfpu(cb_g, cb_g_exp);
+    tile_regs_acquire();
+    copy_tile_to_dst_init_short(cb_g);
+    copy_tile(cb_g, 0, 0);
+    exp_tile_init<false>();
+    exp_tile<false>(0);
+    tile_regs_commit();
+    tile_regs_wait();
+    pack_tile(0, cb_g_exp, 0);
+    tile_regs_release();
+    g_exp_buffer.push_back(1);
+    g_buffer.pop_front(1);
+
+    // state_decay = state * decay.
+    g_exp_buffer.wait_front(1);
+    state_decay_buffer.reserve_back(state_tiles);
+    mul_tiles_bcast_scalar_init_short(cb_state, cb_g_exp);
+    for (uint32_t tile = 0; tile < state_tiles; tile++) {
+        tile_regs_acquire();
+        mul_tiles_bcast_scalar(cb_state, cb_g_exp, tile, 0, 0);
+        tile_regs_commit();
+        tile_regs_wait();
+        pack_tile(0, cb_state_decay, tile);
+        tile_regs_release();
+    }
+    state_decay_buffer.push_back(state_tiles);
+    state_buffer.pop_front(state_tiles);
+    g_exp_buffer.pop_front(1);
+
+    // v_read = k @ state_decay.
+    state_decay_buffer.wait_front(state_tiles);
+    v_read_buffer.reserve_back(val_tiles);
+    matmul_init(cb_k, cb_state_decay);
+    for (uint32_t val_tile = 0; val_tile < val_tiles; val_tile++) {
+        tile_regs_acquire();
+        for (uint32_t key_tile = 0; key_tile < key_tiles; key_tile++) {
+            matmul_tiles(cb_k, cb_state_decay, key_tile, key_tile * val_tiles + val_tile, 0);
+        }
+        tile_regs_commit();
+        tile_regs_wait();
+        pack_tile(0, cb_v_read, val_tile);
+        tile_regs_release();
+    }
+    v_read_buffer.push_back(val_tiles);
+
+    // delta = v - v_read.
+    v_read_buffer.wait_front(val_tiles);
+    delta_buffer.reserve_back(val_tiles);
+    sub_tiles_init(cb_v, cb_v_read);
+    for (uint32_t tile = 0; tile < val_tiles; tile++) {
+        tile_regs_acquire();
+        sub_tiles(cb_v, cb_v_read, tile, tile, 0);
+        tile_regs_commit();
+        tile_regs_wait();
+        pack_tile(0, cb_delta, tile);
+        tile_regs_release();
+    }
+    delta_buffer.push_back(val_tiles);
+    v_buffer.pop_front(val_tiles);
+    v_read_buffer.pop_front(val_tiles);
+
+    // k_col = transpose(k).
+    k_col_buffer.reserve_back(key_tiles);
+    transpose_init(cb_k);
+    for (uint32_t tile = 0; tile < key_tiles; tile++) {
+        tile_regs_acquire();
+        transpose_tile(cb_k, tile, 0);
+        tile_regs_commit();
+        tile_regs_wait();
+        pack_tile(0, cb_k_col, tile);
+        tile_regs_release();
+    }
+    k_col_buffer.push_back(key_tiles);
+    k_buffer.pop_front(key_tiles);
+
+    // outer = k_col @ delta.
+    k_col_buffer.wait_front(key_tiles);
+    delta_buffer.wait_front(val_tiles);
+    outer_buffer.reserve_back(state_tiles);
+    matmul_init(cb_k_col, cb_delta);
+    for (uint32_t key_tile = 0; key_tile < key_tiles; key_tile++) {
+        for (uint32_t val_tile = 0; val_tile < val_tiles; val_tile++) {
+            tile_regs_acquire();
+            matmul_tiles(cb_k_col, cb_delta, key_tile, val_tile, 0);
+            tile_regs_commit();
+            tile_regs_wait();
+            pack_tile(0, cb_outer, key_tile * val_tiles + val_tile);
+            tile_regs_release();
+        }
+    }
+    outer_buffer.push_back(state_tiles);
+    k_col_buffer.pop_front(key_tiles);
+    delta_buffer.pop_front(val_tiles);
+
+    // outer_scaled = outer * beta.
+    outer_buffer.wait_front(state_tiles);
+    outer_scaled_buffer.reserve_back(state_tiles);
+    mul_tiles_bcast_scalar_init_short(cb_outer, cb_beta);
+    for (uint32_t tile = 0; tile < state_tiles; tile++) {
+        tile_regs_acquire();
+        mul_tiles_bcast_scalar(cb_outer, cb_beta, tile, 0, 0);
+        tile_regs_commit();
+        tile_regs_wait();
+        pack_tile(0, cb_outer_scaled, tile);
+        tile_regs_release();
+    }
+    outer_scaled_buffer.push_back(state_tiles);
+    outer_buffer.pop_front(state_tiles);
+    beta_buffer.pop_front(1);
+
+    // state_new = state_decay + outer_scaled.
+    outer_scaled_buffer.wait_front(state_tiles);
+    state_new_buffer.reserve_back(state_tiles);
+    add_tiles_init(cb_state_decay, cb_outer_scaled);
+    for (uint32_t tile = 0; tile < state_tiles; tile++) {
+        tile_regs_acquire();
+        add_tiles(cb_state_decay, cb_outer_scaled, tile, tile, 0);
+        tile_regs_commit();
+        tile_regs_wait();
+        pack_tile(0, cb_state_new, tile);
+        tile_regs_release();
+    }
+    state_new_buffer.push_back(state_tiles);
+    state_decay_buffer.pop_front(state_tiles);
+    outer_scaled_buffer.pop_front(state_tiles);
+
+    // output = q @ state_new. Do not pop state_new: the writer owns that
+    // credit after it observes output, which orders this read before state write.
+    state_new_buffer.wait_front(state_tiles);
+    output_buffer.reserve_back(val_tiles);
+    matmul_init(cb_q, cb_state_new);
+    for (uint32_t val_tile = 0; val_tile < val_tiles; val_tile++) {
+        tile_regs_acquire();
+        for (uint32_t key_tile = 0; key_tile < key_tiles; key_tile++) {
+            matmul_tiles(cb_q, cb_state_new, key_tile, key_tile * val_tiles + val_tile, 0);
+        }
+        tile_regs_commit();
+        tile_regs_wait();
+        pack_tile(0, cb_output, val_tile);
+        tile_regs_release();
+    }
+    output_buffer.push_back(val_tiles);
+    q_buffer.pop_front(key_tiles);
+}
--- a/ttnn/cpp/ttnn/operations/transformer/gated_delta_decode/device/kernels/dataflow/reader_gated_delta_decode.cpp
+++ b/ttnn/cpp/ttnn/operations/transformer/gated_delta_decode/device/kernels/dataflow/reader_gated_delta_decode.cpp
@@ -0,0 +1,93 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <stdint.h>
+
+#include "api/dataflow/circular_buffer.h"
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+#include "api/tensor/noc_traits.h"
+
+void kernel_main() {
+    constexpr uint32_t key_tiles = get_compile_time_arg_val(0);
+    constexpr uint32_t val_tiles = get_compile_time_arg_val(1);
+    constexpr uint32_t state_tiles = key_tiles * val_tiles;
+
+    const uint32_t head = get_arg_val<uint32_t>(0);
+    const uint32_t q_address = get_arg_val<uint32_t>(1);
+    const uint32_t k_address = get_arg_val<uint32_t>(2);
+    const uint32_t v_address = get_arg_val<uint32_t>(3);
+    const uint32_t beta_address = get_arg_val<uint32_t>(4);
+    const uint32_t g_address = get_arg_val<uint32_t>(5);
+    const uint32_t state_address = get_arg_val<uint32_t>(6);
+
+    constexpr uint32_t cb_q = tt::CBIndex::c_0;
+    constexpr uint32_t cb_k = tt::CBIndex::c_1;
+    constexpr uint32_t cb_v = tt::CBIndex::c_2;
+    constexpr uint32_t cb_beta = tt::CBIndex::c_3;
+    constexpr uint32_t cb_g = tt::CBIndex::c_4;
+    constexpr uint32_t cb_state = tt::CBIndex::c_5;
+    constexpr uint32_t tile_bytes = get_tile_size(cb_state);
+
+    constexpr auto q_args = TensorAccessorArgs<2>();
+    const auto q_accessor = TensorAccessor(q_args, q_address, tile_bytes);
+    constexpr auto k_args = TensorAccessorArgs<q_args.next_compile_time_args_offset()>();
+    const auto k_accessor = TensorAccessor(k_args, k_address, tile_bytes);
+    constexpr auto v_args = TensorAccessorArgs<k_args.next_compile_time_args_offset()>();
+    const auto v_accessor = TensorAccessor(v_args, v_address, tile_bytes);
+    constexpr auto beta_args = TensorAccessorArgs<v_args.next_compile_time_args_offset()>();
+    const auto beta_accessor = TensorAccessor(beta_args, beta_address, tile_bytes);
+    constexpr auto g_args = TensorAccessorArgs<beta_args.next_compile_time_args_offset()>();
+    const auto g_accessor = TensorAccessor(g_args, g_address, tile_bytes);
+    constexpr auto state_args = TensorAccessorArgs<g_args.next_compile_time_args_offset()>();
+    const auto state_accessor = TensorAccessor(state_args, state_address, tile_bytes);
+
+    CircularBuffer q_buffer(cb_q);
+    CircularBuffer k_buffer(cb_k);
+    CircularBuffer v_buffer(cb_v);
+    CircularBuffer beta_buffer(cb_beta);
+    CircularBuffer g_buffer(cb_g);
+    CircularBuffer state_buffer(cb_state);
+
+    q_buffer.reserve_back(key_tiles);
+    k_buffer.reserve_back(key_tiles);
+    v_buffer.reserve_back(val_tiles);
+    beta_buffer.reserve_back(1);
+    g_buffer.reserve_back(1);
+    state_buffer.reserve_back(state_tiles);
+
+    Noc noc;
+    const uint32_t q_offset = head * key_tiles;
+    const uint32_t v_offset = head * val_tiles;
+    const uint32_t scalar_offset = head;
+    const uint32_t state_offset = head * state_tiles;
+
+    for (uint32_t tile = 0; tile < key_tiles; tile++) {
+        noc.async_read(
+            q_accessor, q_buffer, tile_bytes, {.page_id = q_offset + tile}, {.offset_bytes = tile * tile_bytes});
+        noc.async_read(
+            k_accessor, k_buffer, tile_bytes, {.page_id = q_offset + tile}, {.offset_bytes = tile * tile_bytes});
+    }
+    for (uint32_t tile = 0; tile < val_tiles; tile++) {
+        noc.async_read(
+            v_accessor, v_buffer, tile_bytes, {.page_id = v_offset + tile}, {.offset_bytes = tile * tile_bytes});
+    }
+    noc.async_read(beta_accessor, beta_buffer, tile_bytes, {.page_id = scalar_offset}, {.offset_bytes = 0});
+    noc.async_read(g_accessor, g_buffer, tile_bytes, {.page_id = scalar_offset}, {.offset_bytes = 0});
+    for (uint32_t tile = 0; tile < state_tiles; tile++) {
+        noc.async_read(
+            state_accessor,
+            state_buffer,
+            tile_bytes,
+            {.page_id = state_offset + tile},
+            {.offset_bytes = tile * tile_bytes});
+    }
+    noc.async_read_barrier();
+
+    q_buffer.push_back(key_tiles);
+    k_buffer.push_back(key_tiles);
+    v_buffer.push_back(val_tiles);
+    beta_buffer.push_back(1);
+    g_buffer.push_back(1);
+    state_buffer.push_back(state_tiles);
+}
--- a/ttnn/cpp/ttnn/operations/transformer/gated_delta_decode/device/kernels/dataflow/writer_gated_delta_decode.cpp
+++ b/ttnn/cpp/ttnn/operations/transformer/gated_delta_decode/device/kernels/dataflow/writer_gated_delta_decode.cpp
@@ -0,0 +1,60 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <stdint.h>
+
+#include "api/dataflow/circular_buffer.h"
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+#include "api/tensor/noc_traits.h"
+
+void kernel_main() {
+    constexpr uint32_t key_tiles = get_compile_time_arg_val(0);
+    constexpr uint32_t val_tiles = get_compile_time_arg_val(1);
+    constexpr uint32_t state_tiles = key_tiles * val_tiles;
+
+    const uint32_t head = get_arg_val<uint32_t>(0);
+    const uint32_t output_address = get_arg_val<uint32_t>(1);
+    const uint32_t state_address = get_arg_val<uint32_t>(2);
+
+    constexpr uint32_t cb_output = tt::CBIndex::c_16;
+    constexpr uint32_t cb_state = tt::CBIndex::c_13;
+    constexpr uint32_t tile_bytes = get_tile_size(cb_output);
+
+    constexpr auto output_args = TensorAccessorArgs<2>();
+    const auto output_accessor = TensorAccessor(output_args, output_address, tile_bytes);
+    constexpr auto state_args = TensorAccessorArgs<output_args.next_compile_time_args_offset()>();
+    const auto state_accessor = TensorAccessor(state_args, state_address, tile_bytes);
+
+    CircularBuffer output_buffer(cb_output);
+    CircularBuffer state_buffer(cb_state);
+    Noc noc;
+
+    // Waiting for output first orders the writer after compute has finished
+    // reading the final-state CB for q @ state. The writer can then pop state.
+    output_buffer.wait_front(val_tiles);
+    const uint32_t output_offset = head * val_tiles;
+    for (uint32_t tile = 0; tile < val_tiles; tile++) {
+        noc.async_write(
+            output_buffer,
+            output_accessor,
+            tile_bytes,
+            {.offset_bytes = tile * tile_bytes},
+            {.page_id = output_offset + tile});
+    }
+    noc.async_write_barrier();
+    output_buffer.pop_front(val_tiles);
+
+    state_buffer.wait_front(state_tiles);
+    const uint32_t state_offset = head * state_tiles;
+    for (uint32_t tile = 0; tile < state_tiles; tile++) {
+        noc.async_write(
+            state_buffer,
+            state_accessor,
+            tile_bytes,
+            {.offset_bytes = tile * tile_bytes},
+            {.page_id = state_offset + tile});
+    }
+    noc.async_write_barrier();
+    state_buffer.pop_front(state_tiles);
+}
