+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include "ttnn/operations/transformer/gated_delta_decode/gated_delta_decode_nanobind.hpp"
+
+#include <nanobind/stl/optional.h>
+#include <nanobind/stl/tuple.h>
+
+#include "ttnn-nanobind/bind_function.hpp"
+#include "ttnn/operations/transformer/gated_delta_decode/gated_delta_decode.hpp"
+
+namespace ttnn::operations::transformer {
+
+void bind_gated_delta_decode(nb::module_& mod) {
+    const auto* doc = R"doc(
+        Fused fp32 single-token gated-delta recurrence.
+
+        q and k must be normalized, and q must include the model scale. g is
+        the log decay. output_state may alias state for trace-safe in-place
+        recurrent-state update.
+
+        Args:
+            q (ttnn.Tensor): [BH, 1, Dk] float32.
+            k (ttnn.Tensor): [BH, 1, Dk] float32.
+            v (ttnn.Tensor): [BH, 1, Dv] float32.
+            beta (ttnn.Tensor): [BH, 1, 1] float32.
+            g (ttnn.Tensor): [BH, 1, 1] float32 log decay.
+            state (ttnn.Tensor): [BH, Dk, Dv] float32.
+
+        Keyword Args:
+            output_state (ttnn.Tensor, optional): Preallocated state output.
+            memory_config (ttnn.MemoryConfig, optional): Output memory config.
+            compute_kernel_config (ttnn.DeviceComputeKernelConfig, optional).
+
+        Returns:
+            tuple[ttnn.Tensor, ttnn.Tensor]: output [BH, 1, Dv] and state [BH, Dk, Dv].
+        )doc";
+
+    ttnn::bind_function<"gated_delta_decode", "ttnn.transformer.">(
+        mod,
+        doc,
+        &ttnn::transformer::gated_delta_decode,
+        nb::arg("q").noconvert(),
+        nb::arg("k").noconvert(),
+        nb::arg("v").noconvert(),
+        nb::arg("beta").noconvert(),
+        nb::arg("g").noconvert(),
+        nb::arg("state").noconvert(),
+        nb::kw_only(),
+        nb::arg("output_state") = nb::none(),
+        nb::arg("memory_config") = nb::none(),
+        nb::arg("compute_kernel_config") = nb::none());
+}
+
+}  // namespace ttnn::operations::transformer
