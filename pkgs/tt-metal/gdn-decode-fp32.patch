+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <optional>
+#include <tuple>
+
+#include "ttnn/operations/core/compute_kernel/compute_kernel_config.hpp"
+#include "ttnn/tensor/tensor.hpp"
+#include "ttnn/types.hpp"
+
+namespace ttnn::transformer {
+
+/**
+ * Fused fp32 single-token gated-delta recurrence.
+ *
+ * q/k are normalized and q is already scaled. g is the log decay.
+ * State may also be supplied as output_state for trace-safe in-place update.
+ */
+std::tuple<ttnn::Tensor, ttnn::Tensor> gated_delta_decode(
+    const ttnn::Tensor& q,
+    const ttnn::Tensor& k,
+    const ttnn::Tensor& v,
+    const ttnn::Tensor& beta,
+    const ttnn::Tensor& g,
+    const ttnn::Tensor& state,
+    const std::optional<ttnn::Tensor>& output_state = std::nullopt,
+    const std::optional<ttnn::MemoryConfig>& memory_config = std::nullopt,
+    const std::optional<ttnn::DeviceComputeKernelConfig>& compute_kernel_config = std::nullopt);
+
+}  // namespace ttnn::transformer
