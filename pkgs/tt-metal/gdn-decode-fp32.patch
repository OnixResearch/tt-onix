+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include "ttnn/operations/transformer/gated_delta_decode/device/gated_delta_decode_program_factory.hpp"
+
+#include <algorithm>
+#include <set>
+#include <vector>
+
+#include <tt-metalium/buffer.hpp>
+#include <tt-metalium/constants.hpp>
+#include <tt-metalium/host_api.hpp>
+#include <tt-metalium/tensor_accessor_args.hpp>
+
+using namespace tt::constants;
+using namespace tt::tt_metal;
+
+namespace ttnn::prim {
+
+GatedDeltaDecodeProgramFactory::cached_program_t GatedDeltaDecodeProgramFactory::create(
+    const GatedDeltaDecodeParams& attrs, const GatedDeltaDecodeInputs& in, std::vector<Tensor>& outputs) {
+    Program program{};
+
+    const uint32_t num_heads = attrs.num_heads;
+    const uint32_t key_tiles = attrs.key_dim / TILE_WIDTH;
+    const uint32_t val_tiles = attrs.val_dim / TILE_WIDTH;
+    const uint32_t state_tiles = key_tiles * val_tiles;
+
+    auto* device = in.q.device();
+    const CoreCoord compute_grid = device->compute_with_storage_grid_size();
+    const uint32_t grid_y = compute_grid.y;
+    TT_FATAL(num_heads <= compute_grid.x * grid_y, "num_heads exceeds the available compute grid");
+
+    std::vector<CoreCoord> head_cores(num_heads);
+    std::set<CoreRange> core_set;
+    for (uint32_t head = 0; head < num_heads; head++) {
+        head_cores[head] = CoreCoord{head / grid_y, head % grid_y};
+        core_set.insert(CoreRange{head_cores[head], head_cores[head]});
+    }
+    const CoreRangeSet cores{core_set};
+
+    constexpr tt::DataFormat data_format = tt::DataFormat::Float32;
+    auto make_cb = [&](uint32_t index, uint32_t tiles) {
+        const uint32_t page_size = tt::tile_size(data_format);
+        CircularBufferConfig config(tiles * page_size, {{index, data_format}});
+        config.set_page_size(index, page_size);
+        CreateCircularBuffer(program, cores, config);
+    };
+
+    make_cb(0, key_tiles);    // q
+    make_cb(1, key_tiles);    // k
+    make_cb(2, val_tiles);    // v
+    make_cb(3, 1);            // beta
+    make_cb(4, 1);            // g
+    make_cb(5, state_tiles);  // state input
+    make_cb(6, 1);            // exp(g)
+    make_cb(7, state_tiles);  // decayed state
+    make_cb(8, val_tiles);    // k @ state
+    make_cb(9, val_tiles);    // delta
+    make_cb(10, key_tiles);   // transposed k
+    make_cb(11, state_tiles); // outer product
+    make_cb(12, state_tiles); // beta-scaled outer product
+    make_cb(13, state_tiles); // final state
+    make_cb(16, val_tiles);   // output
+
+    const std::string kernel_dir =
+        "ttnn/cpp/ttnn/operations/transformer/gated_delta_decode/device/kernels/";
+    const std::vector<uint32_t> compute_args = {key_tiles, val_tiles};
+
+    std::vector<uint32_t> reader_args = compute_args;
+    TensorAccessorArgs(in.q.buffer()).append_to(reader_args);
+    TensorAccessorArgs(in.k.buffer()).append_to(reader_args);
+    TensorAccessorArgs(in.v.buffer()).append_to(reader_args);
+    TensorAccessorArgs(in.beta.buffer()).append_to(reader_args);
+    TensorAccessorArgs(in.g.buffer()).append_to(reader_args);
+    TensorAccessorArgs(in.state.buffer()).append_to(reader_args);
+
+    std::vector<uint32_t> writer_args = compute_args;
+    TensorAccessorArgs(outputs[0].buffer()).append_to(writer_args);
+    TensorAccessorArgs(outputs[1].buffer()).append_to(writer_args);
+
+    const auto reader = CreateKernel(
+        program,
+        kernel_dir + "dataflow/reader_gated_delta_decode.cpp",
+        cores,
+        DataMovementConfig{
+            .processor = DataMovementProcessor::RISCV_1,
+            .noc = NOC::RISCV_1_default,
+            .compile_args = reader_args});
+    const auto writer = CreateKernel(
+        program,
+        kernel_dir + "dataflow/writer_gated_delta_decode.cpp",
+        cores,
+        DataMovementConfig{
+            .processor = DataMovementProcessor::RISCV_0,
+            .noc = NOC::RISCV_0_default,
+            .compile_args = writer_args});
+    const auto compute = CreateKernel(
+        program,
+        kernel_dir + "compute/gated_delta_decode.cpp",
+        cores,
+        ComputeConfig{
+            .math_fidelity = MathFidelity::HiFi4,
+            .fp32_dest_acc_en = true,
+            .math_approx_mode = false,
+            .compile_args = compute_args});
+
+    const uint32_t q_address = in.q.buffer()->address();
+    const uint32_t k_address = in.k.buffer()->address();
+    const uint32_t v_address = in.v.buffer()->address();
+    const uint32_t beta_address = in.beta.buffer()->address();
+    const uint32_t g_address = in.g.buffer()->address();
+    const uint32_t state_address = in.state.buffer()->address();
+    const uint32_t output_address = outputs[0].buffer()->address();
+    const uint32_t output_state_address = outputs[1].buffer()->address();
+
+    for (uint32_t head = 0; head < num_heads; head++) {
+        const auto core = head_cores[head];
+        SetRuntimeArgs(
+            program,
+            reader,
+            core,
+            {head, q_address, k_address, v_address, beta_address, g_address, state_address});
+        SetRuntimeArgs(program, writer, core, {head, output_address, output_state_address});
+        SetRuntimeArgs(program, compute, core, {});
+    }
+
+    return cached_program_t{
+        std::move(program),
+        {
+            .reader_kernel_id = reader,
+            .writer_kernel_id = writer,
+            .compute_kernel_id = compute,
+            .grid_y = grid_y,
+            .num_cores = num_heads,
+        }};
+}
+
+void GatedDeltaDecodeProgramFactory::override_runtime_arguments(
+    cached_program_t& cached,
+    const GatedDeltaDecodeParams& attrs,
+    const GatedDeltaDecodeInputs& in,
+    std::vector<Tensor>& outputs) {
+    auto& program = cached.program;
+    const auto& shared = cached.shared_variables;
+
+    const uint32_t q_address = in.q.buffer()->address();
+    const uint32_t k_address = in.k.buffer()->address();
+    const uint32_t v_address = in.v.buffer()->address();
+    const uint32_t beta_address = in.beta.buffer()->address();
+    const uint32_t g_address = in.g.buffer()->address();
+    const uint32_t state_address = in.state.buffer()->address();
+    const uint32_t output_address = outputs[0].buffer()->address();
+    const uint32_t output_state_address = outputs[1].buffer()->address();
+
+    for (uint32_t head = 0; head < attrs.num_heads; head++) {
+        const CoreCoord core{head / shared.grid_y, head % shared.grid_y};
+        auto& reader_args = GetRuntimeArgs(program, shared.reader_kernel_id, core);
+        reader_args[1] = q_address;
+        reader_args[2] = k_address;
+        reader_args[3] = v_address;
+        reader_args[4] = beta_address;
+        reader_args[5] = g_address;
+        reader_args[6] = state_address;
+
+        auto& writer_args = GetRuntimeArgs(program, shared.writer_kernel_id, core);
+        writer_args[1] = output_address;
+        writer_args[2] = output_state_address;
+    }
+}
+
+}  // namespace ttnn::prim
